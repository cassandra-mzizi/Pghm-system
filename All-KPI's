// Compare KPIs (D6:D14 vs E6:E14) and write traffic-light circles into F6:F14
function compareKPIs() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Benchmark");
  if (!sheet) throw new Error('Benchmark sheet not found.');

  const START_ROW = 6;
  const END_ROW = 14;
  const COL_NAME = 1;   // A
  const COL_VALUE = 4;  // D
  const COL_TARGET = 5; // E
  const COL_STATUS = 6; // F

  // default KPI names in case sheet rows are empty or moved
  const defaultNames = [
    "Litters per sow per year",
    "Total pigs born per litter",
    "Pigs born alive per litter",
    "Pre-weaning mortality (%)",
    "Weaned pigs per sow per year",
    "Farrowing rate (%)",
    "Non-productive sow days",
    "Inter Farrowing period",
    "Days-to-slaughter"
  ];

  // Helpers
  const normalizeDash = s => String(s || '').replace(/[–—−]/g, '-').replace(/\u00A0/g, ' ').trim();
  const extractNumbers = s => {
    if (s === null || s === undefined) return [];
    const m = String(s).match(/-?\d+(\.\d+)?/g);
    return m ? m.map(x => parseFloat(x)) : [];
  };

  // Decide KPI "type" by name keywords
  const detectType = (name) => {
    const n = String(name || '').toLowerCase();
    if (n.includes("pre-weaning") || n.includes("pre weaning") || n.includes("pre-wean") || n.includes("prewean") || n.includes("preweaning")) return 'upper_limit';
    if (n.includes("non-productive") || n.includes("non productive") || n.includes("nonproductive")) return 'upper_limit';
    if (n.includes("inter farrowing") || n.includes("inter-farrowing") || n.includes("interfarrowing")) return 'range_strict';
    if (n.includes("days-to-slaughter") || n.includes("days to slaughter") || n.includes("days to slaughter")) return 'days_pref_lower';
    // otherwise default to higher-is-better range
    return 'range_with_excellent_above';
  };

  const out = [];

  for (let r = 0; r <= END_ROW - START_ROW; r++) {
    const row = START_ROW + r;

    // Read displayed target (getDisplayValue to capture formatting/dashes as shown)
    const rawName = sheet.getRange(row, COL_NAME).getDisplayValue() || defaultNames[r] || '';
    const rawValCell = sheet.getRange(row, COL_VALUE).getValue();
    const rawTarget = sheet.getRange(row, COL_TARGET).getDisplayValue() || '';

    const name = String(rawName).trim();
    let val = rawValCell;

    // Determine if target contains '%' (treat values as percents)
    const targetHasPercent = /%/.test(rawTarget);

    // Normalize numeric actual if necessary:
    // If actual is a string with '%', parse it; if it's a fractional number (<=1) but target has %, scale to 0..100
    if (typeof val === 'string') {
      const s = val.replace('%', '').trim();
      const p = parseFloat(s);
      val = isNaN(p) ? NaN : p;
      if (String(rawValCell).includes('%')) {
        // e.g. "21.29%" -> 21.29
      } else if (targetHasPercent && !String(rawValCell).includes('%')) {
        // if target uses percent but value is a small fraction, scale if <=1
        if (!isNaN(val) && Math.abs(val) <= 1) val = val * 100;
      }
    } else if (typeof val === 'number') {
      // numeric cell
      if (targetHasPercent && Math.abs(val) <= 1) {
        // treat as fraction if target expects percent
        val = val * 100;
      }
    } else {
      val = parseFloat(String(val).replace('%','').trim());
      if (targetHasPercent && !isNaN(val) && Math.abs(val) <= 1) val = val * 100;
    }

    if (isNaN(val)) {
      out.push(['—']);
      continue;
    }

    // Normalize target text
    const cleaned = normalizeDash(rawTarget); // converts other dashes to '-' and trims
    const cleanedNoSpaces = cleaned.replace(/\s+/g, ' ');

    // Determine KPI type by name
    const type = detectType(name);

    let status = '🔴 Poor';

    // 1) Upper-limit format like "< 13%" or "<13"
    if (/^\s*<\s*\d+/.test(cleanedNoSpaces)) {
      const nums = extractNumbers(cleanedNoSpaces);
      const limit = nums.length ? nums[0] : NaN;
      if (!isNaN(limit)) {
        if (val <= 0.5 * limit) status = '🟣 Excellent';
        else if (val <= limit) status = '🟢 Good';
        else if (val <= 1.2 * limit) status = '🟠 Average';
        else status = '🔴 Poor';
      } else {
        status = '—';
      }
    }

    // 2) Range format: "min - max"
    else if (/[0-9]+(\.\d+)?\s*-\s*[0-9]+(\.\d+)?/.test(cleanedNoSpaces)) {
      // make a clean "min-max" without spaces/different dash forms
      const cleanRange = cleanedNoSpaces.replace(/\s*-\s*/, '-');
      const parts = cleanRange.split('-').map(x => parseFloat(x)).filter(x => !isNaN(x));
      if (parts.length >= 2) {
        const min = parts[0];
        const max = parts[1];

        if (type === 'range_with_excellent_above') {
          if (val >= max) status = '🟣 Excellent';
          else if (val >= min) status = '🟢 Good';
          else {
            const ratio = val / min;
            if (ratio >= 0.90) status = '🟠 Average';
            else status = '🔴 Poor';
          }
        }
        else if (type === 'upper_limit') {
          // fallback if someone wrote a range for an upper_limit KPI
          if (val <= min) status = '🟣 Excellent';
          else if (val <= max) status = '🟢 Good';
          else if (val <= max * 1.2) status = '🟠 Average';
          else status = '🔴 Poor';
        }
        else if (type === 'range_strict') {
          // strict in-range is Good; slightly outside (within 5%) -> Average; else Poor
          if (val >= min && val <= max) status = '🟢 Good';
          else if (val >= min * 0.95 && val <= max * 1.05) status = '🟠 Average';
          else status = '🔴 Poor';
        }
        else if (type === 'days_pref_lower') {
          // Special Days-to-slaughter behaviour you asked for:
          if (val < 0) status = '🔴 Poor';
          else if (val < min) {
            if (val >= 100) status = '🟣 Excellent'; // below min but still >=100 -> Excellent
            else status = '🟠 Average';             // too low (unrealistic) -> Average
          } else if (val <= max) status = '🟢 Good';
          else status = '🔴 Poor';
        }
      } else {
        status = '—';
      }
    }

    // 3) If target didn't match patterns, attempt numeric fallback
    else {
      const nums = extractNumbers(cleanedNoSpaces);
      if (nums.length === 1) {
        // single numeric target -> treat as lower bound (higher is better)
        const targetNum = nums[0];
        if (type === 'upper_limit') {
          if (val <= 0.5 * targetNum) status = '🟣 Excellent';
          else if (val <= targetNum) status = '🟢 Good';
          else if (val <= targetNum * 1.2) status = '🟠 Average';
          else status = '🔴 Poor';
        } else {
          // default treat as goal (higher is better)
          if (val >= targetNum) status = '🟣 Excellent';
          else if (val >= 0.9 * targetNum) status = '🟠 Average';
          else status = '🔴 Poor';
        }
      } else {
        status = '—';
      }
    }

    out.push([status]);
  }

  // Write statuses to column F
  sheet.getRange(START_ROW, COL_STATUS, out.length, 1).setValues(out);
  SpreadsheetApp.flush();
}

