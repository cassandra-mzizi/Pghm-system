// normalizeDate function
function normalizeDate(value) {
  if (value instanceof Date && !isNaN(value)) return value;

  if (typeof value === 'number') {
    const ms = Math.round((value - 25569) * 86400 * 1000);
    const d = new Date(ms);
    return isNaN(d) ? null : d;
  }

  if (typeof value === 'string') {
    const s = value.trim().toLowerCase();
    if (!s || s === '-' || s.includes('out') || s.includes('foster')) return null;

    const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
    if (m) {
      const d = parseInt(m[1], 10);
      const mo = parseInt(m[2], 10) - 1;
      let y = parseInt(m[3], 10);
      if (y < 100) y += 2000;
      const dt = new Date(y, mo, d);
      return isNaN(dt) ? null : dt;
    }

    const dt = new Date(value);
    return isNaN(dt) ? null : dt;
  }

  return null;
}

// KPI 8 — Inter-farrowing period - D13 

function calculateInterFarrowingPeriods() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Sow Management Database");
  if (!sheet) throw new Error("Sheet 'Sow Management Database' not found.");

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) throw new Error("No data rows found.");

  // A = Sow ID, C = Parity, G = Farrowing Date
  const data = sheet.getRange(2, 1, lastRow - 1, 7).getValues();

  let sowData = {};
  let allIntervals = [];
  let sowIntervals = {}; // For top/bottom 3

  data.forEach((row) => {
    const sowId = row[0];
    const parity = row[2];
    const farrowDate = row[6];

    if (sowId && parity && farrowDate) {
      const dateObj = (farrowDate instanceof Date) ? farrowDate : new Date(farrowDate);
      if (!isNaN(dateObj)) {
        if (!sowData[sowId]) sowData[sowId] = [];
        sowData[sowId].push({ parity: Number(parity), farrowDate: dateObj });
      }
    }
  });

  for (const sowId in sowData) {
    if (sowData[sowId].length < 2) continue; // skip if only one farrowing
    sowData[sowId].sort((a, b) => a.parity - b.parity);

    for (let i = 1; i < sowData[sowId].length; i++) {
      const prevDate = sowData[sowId][i - 1].farrowDate;
      const currDate = sowData[sowId][i].farrowDate;
      const diffDays = (currDate - prevDate) / (1000 * 60 * 60 * 24);

      if (diffDays > 0) {
        allIntervals.push(diffDays);

        if (!sowIntervals[sowId]) sowIntervals[sowId] = [];
        sowIntervals[sowId].push(diffDays);
      }
    }
  }

  // Herd average
  const herdAvg = allIntervals.length > 0
    ? allIntervals.reduce((a, b) => a + b, 0) / allIntervals.length
    : 0;

  // Calculate per-sow average intervals
  const perSowAvg = Object.entries(sowIntervals).map(([sowId, arr]) => {
    const avg = arr.reduce((a, b) => a + b, 0) / arr.length;
    return { sowId, avg };
  });

  // Sort for top/bottom 3
  perSowAvg.sort((a, b) => a.avg - b.avg); // ascending: shorter = better
  const best3 = perSowAvg.slice(0, 3).map(o => o.sowId).join(", ");
  const worst3 = perSowAvg.slice(-3).map(o => o.sowId).join(", ");

  // Write results
  const benchmarkSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Benchmark");
  if (benchmarkSheet) {
    benchmarkSheet.getRange("D13").setValue(herdAvg).setNumberFormat('0');
    benchmarkSheet.getRange("H13").setValue(best3);   // top 3
    benchmarkSheet.getRange("I13").setValue(worst3);  // bottom 3
  }
}

// KPI 9 — Days to slaughter - D14

function updateDaysToSlaughter() {
  const ss = SpreadsheetApp.getActive();
  const LITTER_SHEET_NAME = 'Litter Management Database';
  const BENCH_SHEET_NAME = 'Benchmark';
  
  const sheet = ss.getSheetByName(LITTER_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  
  if (!sheet || !bench) throw new Error('Required sheet not found.');

  const START_ROW = 2;
  const COL_DOB = "F";
  const COL_KILLED = "N";

  const lastRow = sheet.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange("D14").setValue("—");
    bench.getRange("H14").setValue("—");
    bench.getRange("I14").setValue("—");
    return;
  }

  const dobs = sheet.getRange(`${COL_DOB}${START_ROW}:${COL_DOB}${lastRow}`).getValues().flat();
  const killedDates = sheet.getRange(`${COL_KILLED}${START_ROW}:${COL_KILLED}${lastRow}`).getValues().flat();
  const sowIds = sheet.getRange(`B${START_ROW}:B${lastRow}`).getValues().flat(); // assuming B = Sow Number

  let daysArray = [];

  for (let i = 0; i < dobs.length; i++) {
    const dob = normalizeDate(dobs[i]);
    const killed = normalizeDate(killedDates[i]);
    const sowId = sowIds[i];
    if (dob && killed && killed >= dob) {
      const days = (killed - dob) / 86400000;
      daysArray.push({ sowId, days });
    }
  }

  if (daysArray.length === 0) {
    bench.getRange("D14").setValue("—");
    bench.getRange("H14").setValue("—");
    bench.getRange("I14").setValue("—");
    return;
  }

  // Herd average
  const avgDTS = daysArray.reduce((sum, obj) => sum + obj.days, 0) / daysArray.length;
  bench.getRange("D14").setValue(avgDTS).setNumberFormat('0');

  // Sort for top/bottom 3
  daysArray.sort((a, b) => a.days - b.days); // ascending: fastest = best

  const top3 = daysArray.slice(0, 3).map(o => o.sowId).join(", ");
  const bottom3 = daysArray.slice(-3).map(o => o.sowId).join(", ");

  bench.getRange("H14").setValue(top3);   // fastest 3
  bench.getRange("I14").setValue(bottom3); // slowest 3
}

