// KPI 1 — Litters per sow per year - D6

function updateKPI1_LittersPerSowPerYear() {
  const ss = SpreadsheetApp.getActive();
  const LMD_SHEET_NAME = 'Litter Management Database';
  const BENCH_SHEET_NAME = 'Benchmark';

  const lmd = ss.getSheetByName(LMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!lmd || !bench) throw new Error('Sheet not found.');

  const HEADER_ROW = 1;
  const START_ROW = 2;
  const START_COL = 2;  // B
  const NUM_COLS = 18;

  const lastRow = lmd.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange('D6:I6').setValue('—');
    return;
  }

  // Pull headers and data
  const headers = lmd.getRange(HEADER_ROW, START_COL, 1, NUM_COLS).getValues()[0];
  const data = lmd.getRange(START_ROW, START_COL, lastRow - START_ROW + 1, NUM_COLS).getValues();

  const IDX_SOW = headers.indexOf("Sow Number");
  const IDX_DOB = headers.indexOf("D.O.B");
  if (IDX_SOW === -1 || IDX_DOB === -1) throw new Error('Required columns missing.');

  // Collect farrowing dates per sow
  const farrowingsBySow = {};
  for (const row of data) {
    const sowId = String(row[IDX_SOW]).trim();
    const dob = normalizeDate(row[IDX_DOB]);
    if (!sowId || !dob) continue;
    if (!farrowingsBySow[sowId]) farrowingsBySow[sowId] = [];
    farrowingsBySow[sowId].push(dob);
  }

  // Compute per-sow LPY
  const perSowLPY = [];
  for (const [sowId, dates] of Object.entries(farrowingsBySow)) {
    if (dates.length < 2) continue;
    dates.sort((a, b) => a - b);

    const gaps = [];
    for (let i = 1; i < dates.length; i++) {
      const days = (dates[i] - dates[i - 1]) / 86400000;
      if (days >= 100 && days <= 190) gaps.push(days);
    }
    if (gaps.length === 0) continue;

    const avgIFP = gaps.reduce((a, b) => a + b, 0) / gaps.length;
    const lpy = 365 / avgIFP;
    perSowLPY.push({ sowId, value: lpy });
  }

  if (perSowLPY.length === 0) {
    bench.getRange('D6:I6').setValue('—');
    return;
  }

  // ✅ Calculate herd average
  const herdLPY = perSowLPY.reduce((sum, s) => sum + s.value, 0) / perSowLPY.length;

  // Write average explicitly
  bench.getRange('D6').setValue(herdLPY).setNumberFormat('0.0');

  // ✅ Rank sows
  perSowLPY.sort((a, b) => b.value - a.value); // higher is better

  const best = perSowLPY.slice(0, 3).map(s => s.sowId).join(", "); 
  const worst = perSowLPY.slice(-3).map(s => s.sowId).join(", "); 
 
  bench.getRange('H6').setValue(best || "—"); 
  bench.getRange('I6').setValue(worst || "—");
}


 //Robustly convert assorted cell contents to a Date or return null.

function normalizeDate(value) {
  if (value instanceof Date && !isNaN(value)) return value;

  if (typeof value === 'number') {
    const ms = Math.round((value - 25569) * 86400 * 1000);
    const d = new Date(ms);
    return isNaN(d) ? null : d;
  }

  if (typeof value === 'string') {
    const s = value.trim().toLowerCase();
    if (!s || s === '-' || s.includes('out') || s.includes('foster')) return null;

    const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
    if (m) {
      const d = parseInt(m[1], 10);
      const mo = parseInt(m[2], 10) - 1;
      let y = parseInt(m[3], 10);
      if (y < 100) y += 2000;
      const dt = new Date(y, mo, d);
      return isNaN(dt) ? null : dt;
    }

    const dt = new Date(value);
    return isNaN(dt) ? null : dt;
  }

  return null;
}

// KPI 2 — Total pigs born per litter - D7

function calculateTotalPigsBornPerLitter() {
   const ss = SpreadsheetApp.getActive();
  const LMD_SHEET_NAME = "Litter Management Database";
  const BENCH_SHEET_NAME = "Benchmark";

  const lmd = ss.getSheetByName(LMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!lmd || !bench) throw new Error("Sheet not found.");

  const lastRow = lmd.getLastRow();
  if (lastRow < 2) {
    bench.getRange("D7").setValue('—');
    bench.getRange("H7").setValue('—');
    bench.getRange("I7").setValue('—');
    return;
  }

  // --- Global litter-average (match original behaviour) ---
  // Read all values in column G (Total born)
  const rawTotals = lmd.getRange(2, 7, lastRow - 1, 1).getValues().flat(); // column G = 7
  // Mimic filter(Number): remove empty / non-numeric / zero (falsy) entries
  const totalNums = rawTotals
    .map(v => {
      // keep numeric strings too
      if (v === null || v === undefined || v === '') return NaN;
      const n = Number(v);
      return isNaN(n) ? NaN : n;
    })
    .filter(n => !isNaN(n) && n !== 0); // exclude zeros to match filter(Number) behaviour

  if (totalNums.length === 0) {
    bench.getRange("D7").setValue('—');
  } else {
    const globalAvg = totalNums.reduce((a, b) => a + b, 0) / totalNums.length;
    bench.getRange("D7").setValue(globalAvg).setNumberFormat('0');
  }

  // --- Per-sow averages for ranking (H7 / I7) ---
  // Read Sow IDs (col B) and Total Born (col G)
  const sowIds = lmd.getRange(2, 2, lastRow - 1, 1).getValues().flat(); // column B = 2
  const totals = rawTotals; // we already read G2:G

  const perSow = {};
  for (let i = 0; i < sowIds.length; i++) {
    const sidRaw = sowIds[i];
    const valRaw = totals[i];
    if (sidRaw === null || sidRaw === undefined || String(sidRaw).trim() === '') continue;
    const sowId = String(sidRaw).trim();
    const num = Number(valRaw);
    if (isNaN(num)) continue; // skip non-numeric
    // do include zeros here if you want them counted for sow-average; adjust if not
    if (!perSow[sowId]) perSow[sowId] = [];
    perSow[sowId].push(num);
  }

  const perSowAverages = Object.entries(perSow).map(([sowId, arr]) => {
    const avg = arr.reduce((a, b) => a + b, 0) / arr.length;
    return { sowId, value: avg, count: arr.length };
  });

  if (perSowAverages.length === 0) {
    bench.getRange("H7").setValue('—');
    bench.getRange("I7").setValue('—');
    return;
  }

  // Sort descending (higher total born per litter = better)
  perSowAverages.sort((a, b) => b.value - a.value);

  const best3 = perSowAverages.slice(0, 3).map(s => s.sowId).join(", ");
  const worst3 = perSowAverages.slice(-3).map(s => s.sowId).join(", ");

  bench.getRange("H7").setValue(best3 || "—");
  bench.getRange("I7").setValue(worst3 || "—");
}


