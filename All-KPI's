// ── KPI 4 — Pre-Weaning Mortality % → D9 ─────────────────────
// Formula: (Dead + Mummified) / Born Alive * 100
// Best ranking: sows with ≥2 litters, lowest mortality, tiebreak by most litters
// Worst ranking: all sows, highest mortality (even 1 bad litter is a red flag)
function calculatePreWeaningMortality() {
  const ss    = SpreadsheetApp.getActive();
  const lmd   = ss.getSheetByName('Litter Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!lmd || !bench) throw new Error('Required sheet not found.');

  const lastRow = lmd.getLastRow();
  if (lastRow < 2) {
    bench.getRange('D9').setValue('—');
    bench.getRange('H9').setValue('—');
    bench.getRange('I9').setValue('—');
    return;
  }

  // col B=2, col H=8 (Dead), col I=9 (Mummified), col K=11 (Born Alive)
  const sowIds    = lmd.getRange(2, 2,  lastRow - 1, 1).getValues().flat();
  const bornAlive = lmd.getRange(2, 11, lastRow - 1, 1).getValues().flat();
  const deadVals  = lmd.getRange(2, 8,  lastRow - 1, 1).getValues().flat();
  const mummVals  = lmd.getRange(2, 9,  lastRow - 1, 1).getValues().flat();

  let totalAlive = 0, totalDead = 0, totalMumm = 0;
  const perSow = {};

  for (let i = 0; i < sowIds.length; i++) {
    const sowId = String(sowIds[i] ?? '').trim();
    const alive  = Number(bornAlive[i]);
    const dead   = isNaN(Number(deadVals[i])) ? 0 : Number(deadVals[i]);
    const mumm   = isNaN(Number(mummVals[i])) ? 0 : Number(mummVals[i]);

    if (!sowId || isNaN(alive) || alive <= 0) continue;

    totalAlive += alive;
    totalDead  += dead;
    totalMumm  += mumm;

    if (!perSow[sowId]) perSow[sowId] = { alive: 0, dead: 0, mumm: 0, litters: 0 };
    perSow[sowId].alive   += alive;
    perSow[sowId].dead    += dead;
    perSow[sowId].mumm    += mumm;
    perSow[sowId].litters += 1;
  }

  const mortality = totalAlive > 0 ? ((totalDead + totalMumm) / totalAlive) * 100 : 0;
  bench.getRange('D9').setValue(mortality).setNumberFormat('0.0"%"');

  const allSowMortality = Object.entries(perSow).map(([sowId, v]) => ({
    sowId,
    value: ((v.dead + v.mumm) / v.alive) * 100,
    litters: v.litters
  }));

  if (allSowMortality.length === 0) {
    bench.getRange('H9').setValue('—');
    bench.getRange('I9').setValue('—');
    return;
  }

  // Best: ≥2 litters only, lowest mortality first, tiebreak by most litters
  const best3 = allSowMortality
    .filter(s => s.litters >= 2)
    .sort((a, b) => a.value - b.value || b.litters - a.litters)
    .slice(0, 3)
    .map(s => `${s.sowId} (${s.value.toFixed(1)}%)`)
    .join('\n');

  // Worst: all sows, highest mortality first — even 1 litter counts as a red flag
  const worst3 = [...allSowMortality]
    .sort((a, b) => b.value - a.value)
    .slice(0, 3)
    .map(s => `${s.sowId} (${s.value.toFixed(1)}%)`)
    .join('\n');

  bench.getRange('H9').setValue(best3  || '—').setWrap(true);
  bench.getRange('I9').setValue(worst3 || '—').setWrap(true);
}

// ── KPI 5 — Weaned Pigs per Sow per Year (PSY) → D10 ─────────
// Formula: avg weaned per litter * LSY (from D6)
// Depends on KPI 1 having already written D6 — always run via updateKPIs()
function updateKPI5_WeanedPigsPerSowPerYear() {
  const ss    = SpreadsheetApp.getActive();
  const lmd   = ss.getSheetByName('Litter Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!lmd || !bench) throw new Error('Required sheet not found.');

  const lastRow = lmd.getLastRow();
  if (lastRow < 2) {
    bench.getRange('D10').setValue('—');
    bench.getRange('H10').setValue('—');
    bench.getRange('I10').setValue('—');
    return;
  }

  const START_COL = 2;  // col B
  const NUM_COLS  = 19;

  // 0-based indices from col B (START_COL=2)
  const IDX_SOW        = 0;  // B  = Sow Number
  const IDX_BORN_ALIVE = 9;  // K  = Born Alive  (col 11 - 2 = 9)
  const IDX_WEANED     = 12; // N  = Number Weaned (col 14 - 2 = 12)

  const data = lmd.getRange(2, START_COL, lastRow - 1, NUM_COLS).getValues();
  const perSow = {};

  for (const row of data) {
    const sowIdRaw  = row[IDX_SOW];
    const bornAlive = Number(row[IDX_BORN_ALIVE]);
    const weanedRaw = row[IDX_WEANED];
    const weaned    = Number(weanedRaw);

    if (!sowIdRaw || isNaN(bornAlive) || bornAlive <= 0) continue;
    // Skip litters where weaning hasn't been recorded yet
    if (weanedRaw === '' || weanedRaw === null || weanedRaw === undefined) continue;
    if (isNaN(weaned)) continue;

    const sowId = String(sowIdRaw).trim();
    if (!perSow[sowId]) perSow[sowId] = { totalWeaned: 0, litters: 0 };
    perSow[sowId].totalWeaned += weaned;
    perSow[sowId].litters++;
  }

  const herdTotalWeaned  = Object.values(perSow).reduce((s, v) => s + v.totalWeaned, 0);
  const herdTotalLitters = Object.values(perSow).reduce((s, v) => s + v.litters, 0);

  if (herdTotalLitters === 0) {
    bench.getRange('D10').setValue('—');
    bench.getRange('H10').setValue('—');
    bench.getRange('I10').setValue('—');
    return;
  }

  const avgWeanedPerLitter   = herdTotalWeaned / herdTotalLitters;
  const littersPerSowPerYear = parseFloat(bench.getRange('D6').getValue()) || 0;
  const psy                  = avgWeanedPerLitter * littersPerSowPerYear;

  bench.getRange('D10').setValue(psy).setNumberFormat('0');

  const perSowPerf = Object.entries(perSow)
    .map(([sowId, obj]) => ({
      sowId,
      value: (obj.totalWeaned / obj.litters) * littersPerSowPerYear
    }))
    .sort((a, b) => b.value - a.value);

  bench.getRange('H10').setValue(perSowPerf.slice(0, 3).map(s => `${s.sowId} (${s.value.toFixed(1)})`).join('\n') || '—').setWrap(true);
  bench.getRange('I10').setValue(perSowPerf.slice(-3).map(s => `${s.sowId} (${s.value.toFixed(1)})`).join('\n') || '—').setWrap(true);
}

// ── KPI 6 — Farrowing Rate % → D11 ───────────────────────────
// Formula: sows farrowed / sows mated * 100
function updateKPI6_FarrowingRate() {
  const ss    = SpreadsheetApp.getActive();
  const smd   = ss.getSheetByName('Sow Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!smd || !bench) throw new Error('Required sheet not found.');

  const lastRow = smd.getLastRow();
  if (lastRow < 2) {
    bench.getRange('D11').setValue('—');
    bench.getRange('H11').setValue('—');
    bench.getRange('I11').setValue('—');
    return;
  }

  // 0-based indices from col A (START_COL=1)
  const IDX_SOW      = 0; // A = Sow Id
  const IDX_MATED    = 5; // F = Date Mated
  const IDX_FARROWED = 6; // G = Actual Farrowing Date

  const data = smd.getRange(2, 1, lastRow - 1, 31).getValues();
  const perSow = {};
  let totalMatings = 0, totalFarrowings = 0;

  for (const row of data) {
    const sowId = String(row[IDX_SOW] ?? '').trim();
    if (!sowId) continue;

    const mated    = normalizeDate(row[IDX_MATED]);
    const farrowed = normalizeDate(row[IDX_FARROWED]);

    if (!perSow[sowId]) perSow[sowId] = { matings: 0, farrowings: 0 };

    if (mated)    { perSow[sowId].matings++;    totalMatings++;    }
    if (farrowed) { perSow[sowId].farrowings++; totalFarrowings++; }
  }

  const herdRate = totalMatings > 0 ? (totalFarrowings / totalMatings) * 100 : 0;
  bench.getRange('D11').setValue(herdRate).setNumberFormat('0.0"%"');

  const perf = Object.entries(perSow)
    .filter(([_, v]) => v.matings > 0)
    .map(([id, v]) => ({ sowId: id, value: (v.farrowings / v.matings) * 100 }))
    .sort((a, b) => b.value - a.value);

  if (perf.length === 0) {
    bench.getRange('H11').setValue('—');
    bench.getRange('I11').setValue('—');
    return;
  }

  bench.getRange('H11').setValue(perf.slice(0, 3).map(s => `${s.sowId} (${s.value.toFixed(1)}%)`).join('\n') || '—').setWrap(true);
  bench.getRange('I11').setValue(perf.slice(-3).map(s => `${s.sowId} (${s.value.toFixed(1)}%)`).join('\n') || '—').setWrap(true);
}

// ── KPI 7 — Weaning to Service Interval (WSI) → D12 ──────────
// Formula: days from weaning date to next mating date per sow
// Realistic WSI range: 3–60 days. Will show — until cycles complete.
function updateKPI7NonProductiveSowDays() {
  const ss    = SpreadsheetApp.getActive();
  const smd   = ss.getSheetByName('Sow Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!smd || !bench) throw new Error('Required sheet not found.');

  const lastRow = smd.getLastRow();
  if (lastRow < 2) {
    bench.getRange('D12').setValue('—');
    bench.getRange('H12').setValue('—');
    bench.getRange('I12').setValue('—');
    return;
  }

  // 0-based indices from col A
  const IDX_SOW    = 0; // A = Sow Id
  const IDX_MATED  = 5; // F = Date Mated
  const IDX_WEANED = 7; // H = Date Weaned

  const data = smd.getRange(2, 1, lastRow - 1, 32).getValues();
  const sowData = {};

  for (const row of data) {
    const sowId = String(row[IDX_SOW] ?? '').trim();
    if (!sowId) continue;
    const mated  = normalizeDate(row[IDX_MATED]);
    const weaned = normalizeDate(row[IDX_WEANED]);
    if (!sowData[sowId]) sowData[sowId] = { matings: [], weanings: [] };
    if (mated)  sowData[sowId].matings.push(mated);
    if (weaned) sowData[sowId].weanings.push(weaned);
  }

  // Match each weaning date to the first mating that came after it
  const allIntervals    = [];
  const perSowIntervals = {};

  for (const [sowId, d] of Object.entries(sowData)) {
    d.matings.sort((a, b)  => a - b);
    d.weanings.sort((a, b) => a - b);

    for (const weanDate of d.weanings) {
      const nextMating = d.matings.find(m => m > weanDate);
      if (!nextMating) continue;

      const gap = (nextMating - weanDate) / 86400000;
      if (gap < 3 || gap > 60) continue; // outside realistic WSI range

      allIntervals.push(gap);
      if (!perSowIntervals[sowId]) perSowIntervals[sowId] = [];
      perSowIntervals[sowId].push(gap);
    }
  }

  if (allIntervals.length === 0) {
    bench.getRange('D12').setValue('—');
    bench.getRange('H12').setValue('—');
    bench.getRange('I12').setValue('—');
    return;
  }

  const avgWSI = allIntervals.reduce((a, b) => a + b, 0) / allIntervals.length;
  bench.getRange('D12').setValue(avgWSI).setNumberFormat('0');

  // Lower WSI is better (faster return to reproduction)
  const perf = Object.entries(perSowIntervals)
    .map(([sowId, arr]) => ({ sowId, value: arr.reduce((a, b) => a + b, 0) / arr.length }))
    .sort((a, b) => a.value - b.value);

  if (perf.length === 0) {
    bench.getRange('H12').setValue('—');
    bench.getRange('I12').setValue('—');
    return;
  }

  bench.getRange('H12').setValue(perf.slice(0, 3).map(s => `${s.sowId} (${s.value.toFixed(1)}d)`).join('\n') || '—').setWrap(true);
  bench.getRange('I12').setValue(perf.slice(-3).map(s => `${s.sowId} (${s.value.toFixed(1)}d)`).join('\n') || '—').setWrap(true);
}

// ── KPI 8 — Inter-Farrowing Period (IFP) → D13 ───────────────
// Formula: days between consecutive farrowings per sow
// Source: LMD (full farrowing history). Realistic range: 100–300 days.
function calculateInterFarrowingPeriods() {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const lmd   = ss.getSheetByName('Litter Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!lmd || !bench) throw new Error('Required sheet not found.');

  const lastRow = lmd.getLastRow();

  // Graceful exit instead of throwing — keeps updateKPIs() chain running
  if (lastRow < 2) {
    bench.getRange('D13').setValue('—');
    bench.getRange('H13').setValue('—');
    bench.getRange('I13').setValue('—');
    return;
  }

  // 0-based from col B (START_COL=2): row[0]=SowNumber, row[4]=DOB
  const IDX_SOW = 0; // B = Sow Number
  const IDX_DOB = 4; // F = D.O.B

  const data = lmd.getRange(2, 2, lastRow - 1, 19).getValues();
  const sowFarrows = {};

  for (const row of data) {
    const sowId     = String(row[IDX_SOW] ?? '').trim();
    const farrowDate = normalizeDate(row[IDX_DOB]);
    if (!sowId || !farrowDate) continue;
    sowFarrows[sowId] = sowFarrows[sowId] || [];
    sowFarrows[sowId].push(farrowDate);
  }

  const allIntervals = [];
  const sowIntervals = {};

  for (const [sowId, dates] of Object.entries(sowFarrows)) {
    if (dates.length < 2) continue; // need at least 2 farrowings for an interval
    dates.sort((a, b) => a - b);

    for (let i = 1; i < dates.length; i++) {
      const diff = (dates[i] - dates[i - 1]) / 86400000;
      if (diff < 100 || diff > 300) continue; // filter unrealistic gaps
      allIntervals.push(diff);
      sowIntervals[sowId] = sowIntervals[sowId] || [];
      sowIntervals[sowId].push(diff);
    }
  }

  const herdAvg = allIntervals.length > 0
    ? allIntervals.reduce((a, b) => a + b, 0) / allIntervals.length
    : 0;

  bench.getRange('D13').setValue(herdAvg || '—').setNumberFormat('0');

  const perSowAvg = Object.entries(sowIntervals)
    .map(([sowId, arr]) => ({ sowId, avg: arr.reduce((a, b) => a + b, 0) / arr.length }))
    .sort((a, b) => a.avg - b.avg); // shorter IFP = better

  if (perSowAvg.length === 0) {
    bench.getRange('H13').setValue('—');
    bench.getRange('I13').setValue('—');
    return;
  }

  bench.getRange('H13').setValue(perSowAvg.slice(0, 3).map(o => `${o.sowId} (${o.avg.toFixed(1)}d)`).join('\n') || '—').setWrap(true);
  bench.getRange('I13').setValue(perSowAvg.slice(-3).map(o => `${o.sowId} (${o.avg.toFixed(1)}d)`).join('\n') || '—').setWrap(true);
}

// ── KPI 9 — Days to Slaughter → D14 ──────────────────────────
// Formula: Date Killed - D.O.B
function updateDaysToSlaughter() {
  const ss    = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName('Litter Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!sheet || !bench) throw new Error('Required sheet not found.');

  const START_ROW  = 2;
  const COL_SOW    = 'B'; // Sow Number
  const COL_DOB    = 'F'; // D.O.B
  const COL_KILLED = 'O'; // Date Killed

  const lastRow = sheet.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange('D14').setValue('—');
    bench.getRange('H14').setValue('—');
    bench.getRange('I14').setValue('—');
    return;
  }

  const sowIds      = sheet.getRange(`${COL_SOW}${START_ROW}:${COL_SOW}${lastRow}`).getValues().flat();
  const dobs        = sheet.getRange(`${COL_DOB}${START_ROW}:${COL_DOB}${lastRow}`).getValues().flat();
  const killedDates = sheet.getRange(`${COL_KILLED}${START_ROW}:${COL_KILLED}${lastRow}`).getValues().flat();

  const daysArray = [];

  for (let i = 0; i < dobs.length; i++) {
    const sowId = String(sowIds[i] ?? '').trim();
    const dob    = normalizeDate(dobs[i]);
    const killed = normalizeDate(killedDates[i]);

    if (!sowId || !dob || !killed || killed < dob) continue;

    const days = (killed - dob) / 86400000;
    daysArray.push({ sowId, days });
  }

  if (daysArray.length === 0) {
    bench.getRange('D14').setValue('—');
    bench.getRange('H14').setValue('—');
    bench.getRange('I14').setValue('—');
    return;
  }

  const avgDTS = daysArray.reduce((sum, o) => sum + o.days, 0) / daysArray.length;
  bench.getRange('D14').setValue(avgDTS).setNumberFormat('0');

  // Faster to slaughter = better (lower days = best)
  daysArray.sort((a, b) => a.days - b.days);

  bench.getRange('H14').setValue(daysArray.slice(0, 3).map(o => `${o.sowId} (${o.days}d)`).join('\n') || '—').setWrap(true);
  bench.getRange('I14').setValue(daysArray.slice(-3).map(o => `${o.sowId} (${o.days}d)`).join('\n') || '—').setWrap(true);
}

// ── COMPARE KPIs → F6:F14 ────────────────────────────────────
// Reads D (actual) vs E (target) and writes traffic-light status to F
function compareKPIs() {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Benchmark');
  if (!sheet) throw new Error('Benchmark sheet not found.');

  const START_ROW  = 6;
  const END_ROW    = 14;
  const COL_NAME   = 1; // A
  const COL_VALUE  = 4; // D
  const COL_TARGET = 5; // E
  const COL_STATUS = 6; // F

  const defaultNames = [
    'Litters per sow per year',
    'Total pigs born per litter',
    'Pigs born alive per litter',
    'Pre-weaning mortality (%)',
    'Weaned pigs per sow per year',
    'Farrowing rate (%)',
    'Non-productive sow days',
    'Inter Farrowing period',
    'Days-to-slaughter'
  ];

  const normalizeDash = s => String(s || '').replace(/[–—−]/g, '-').replace(/\u00A0/g, ' ').trim();
  const extractNumbers = s => {
    const m = String(s).match(/-?\d+(\.\d+)?/g);
    return m ? m.map(x => parseFloat(x)) : [];
  };

  // Determine comparison direction based on KPI name
  const detectType = name => {
    const n = String(name || '').toLowerCase();
    if (n.includes('pre-weaning') || n.includes('pre weaning') || n.includes('prewean'))     return 'upper_limit';
    if (n.includes('non-productive') || n.includes('non productive'))                         return 'upper_limit';
    if (n.includes('inter farrowing') || n.includes('inter-farrowing'))                       return 'range_strict';
    if (n.includes('days-to-slaughter') || n.includes('days to slaughter'))                   return 'days_pref_lower';
    return 'range_with_excellent_above'; // default: higher is better
  };

  const out = [];

  for (let r = 0; r <= END_ROW - START_ROW; r++) {
    const row        = START_ROW + r;
    const rawName    = sheet.getRange(row, COL_NAME).getDisplayValue() || defaultNames[r] || '';
    const rawValCell = sheet.getRange(row, COL_VALUE).getValue();
    const rawTarget  = sheet.getRange(row, COL_TARGET).getDisplayValue() || '';

    const name            = String(rawName).trim();
    const targetHasPercent = /%/.test(rawTarget);

    // Normalise actual value to a number
    let val = rawValCell;
    if (typeof val === 'string') {
      val = parseFloat(val.replace('%', '').trim());
    } else if (typeof val === 'number') {
      if (targetHasPercent && Math.abs(val) <= 1) val = val * 100; // fraction → percent
    } else {
      val = parseFloat(String(val).replace('%', '').trim());
    }

    if (isNaN(val)) { out.push(['—']); continue; }

    const cleaned        = normalizeDash(rawTarget);
    const cleanedNoSpace = cleaned.replace(/\s+/g, ' ');
    const type           = detectType(name);
    let   status         = '🔴 Poor';

    // Pattern 1: upper limit  e.g. "< 13%"
    if (/^\s*<\s*\d+/.test(cleanedNoSpace)) {
      const limit = extractNumbers(cleanedNoSpace)[0] ?? NaN;
      if (!isNaN(limit)) {
        if      (val <= 0.5 * limit)  status = '🟣 Excellent';
        else if (val <= limit)         status = '🟢 Good';
        else if (val <= 1.2 * limit)  status = '🟠 Average';
        else                           status = '🔴 Poor';
      } else {
        status = '—';
      }

    // Pattern 2: range  e.g. "140 - 160"
    } else if (/[0-9]+(\.\d+)?\s*-\s*[0-9]+(\.\d+)?/.test(cleanedNoSpace)) {
      const parts = cleanedNoSpace.replace(/\s*-\s*/, '-').split('-').map(parseFloat).filter(x => !isNaN(x));
      if (parts.length >= 2) {
        const [min, max] = parts;
        if (type === 'range_with_excellent_above') {
          if      (val >= max)              status = '🟣 Excellent';
          else if (val >= min)              status = '🟢 Good';
          else if (val / min >= 0.90)       status = '🟠 Average';
          else                              status = '🔴 Poor';
        } else if (type === 'upper_limit') {
          if      (val <= min)              status = '🟣 Excellent';
          else if (val <= max)              status = '🟢 Good';
          else if (val <= max * 1.2)        status = '🟠 Average';
          else                              status = '🔴 Poor';
        } else if (type === 'range_strict') {
          if      (val >= min && val <= max)                       status = '🟢 Good';
          else if (val >= min * 0.95 && val <= max * 1.05)        status = '🟠 Average';
          else                                                      status = '🔴 Poor';
        } else if (type === 'days_pref_lower') {
          if      (val < 0)    status = '🔴 Poor';
          else if (val < min)  status = val >= 100 ? '🟣 Excellent' : '🟠 Average';
          else if (val <= max) status = '🟢 Good';
          else                 status = '🔴 Poor';
        }
      } else {
        status = '—';
      }

    // Pattern 3: single number fallback
    } else {
      const nums = extractNumbers(cleanedNoSpace);
      if (nums.length === 1) {
        const targetNum = nums[0];
        if (type === 'upper_limit') {
          if      (val <= 0.5 * targetNum)  status = '🟣 Excellent';
          else if (val <= targetNum)         status = '🟢 Good';
          else if (val <= targetNum * 1.2)  status = '🟠 Average';
          else                               status = '🔴 Poor';
        } else {
          if      (val >= targetNum)         status = '🟣 Excellent';
          else if (val >= 0.9 * targetNum)   status = '🟠 Average';
          else                               status = '🔴 Poor';
        }
      } else {
        status = '—';
      }
    }

    out.push([status]);
  }

  sheet.getRange(START_ROW, COL_STATUS, out.length, 1).setValues(out);
  SpreadsheetApp.flush();
}

// ── RECOMMENDATIONS → G6:G14 ─────────────────────────────────
// Reads status from F and writes a plain-text recommendation to G
function generateRecommendations() {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Benchmark');
  if (!sheet) throw new Error('Benchmark sheet not found.');

  const START_ROW  = 6;
  const END_ROW    = 14;
  const COL_NAME   = 1; // A
  const COL_VALUE  = 4; // D
  const COL_STATUS = 6; // F
  const COL_RECOMM = 7; // G

  const numRows = END_ROW - START_ROW + 1;
  const data    = sheet.getRange(START_ROW, COL_NAME, numRows, 6).getValues();

  // Article links — update each URL to your actual document links
  const articleLinks = [
    'https://docs.google.com/document/d/ARTICLE1/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE2/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE3/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE4/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE5/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE6/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE7/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE8/view?usp=sharing',
    'https://docs.google.com/document/d/ARTICLE9/view?usp=sharing',
  ];

  for (let i = 0; i < data.length; i++) {
    const status = String(data[i][5] || '').trim(); // col F (index 5 relative to col A)

    let rec = '';
    if      (/excellent/i.test(status)) rec = "You're very well above industry standards. Fantastic job!";
    else if (/good/i.test(status))      rec = "You're well above industry standards. Keep it up!";
    else if (/average/i.test(status))   rec = "You are on par with industry standards.\nTo further improve and become more efficient and profitable, we suggest you do Topic 4 of our Comprehensive Pigfarming Course: https://www.training4farmers.com/pig-farming-course";
    else if (/poor/i.test(status))      rec = "Don't be discouraged. Numbers can initially be low when starting your piggery or when swopping out new breeding stock. To improve your efficiencies and profitability, strongly consider doing our Comprehensive Pigfarming Course: www.training4farmers.com\n(Or at the very least do Topic 4 of our course)";
    else                                rec = 'No data available for this KPI.';

    const cell    = sheet.getRange(START_ROW + i, COL_RECOMM);
    // Write plain text — rich text with hyperlinks is added below if needed
    const richVal = SpreadsheetApp.newRichTextValue()
      .setText(rec)
      .setTextStyle(SpreadsheetApp.newTextStyle().setFontSize(11).build())
      .build();
    cell.setRichTextValue(richVal);
  }

  SpreadsheetApp.getUi().alert(
    '✅ Recommendations generated successfully.\n\n' +
    'Note: if you have just started your piggery or changed some of your stock, ' +
    'your numbers might show as underperforming. It can take a while to reach industry standards — don\'t be alarmed.'
  );
}

