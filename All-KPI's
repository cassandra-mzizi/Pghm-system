/* ============================================================
 Column reference (Litter Management Database):
   Sheet col  B = Sow Number        (array index 0 when START_COL=2)
   Sheet col  F = D.O.B             (array index 4)
   Sheet col  G = Total Born        (sheet col 7)
   Sheet col  H = Dead              (sheet col 8)
   Sheet col  I = Mummified         (sheet col 9)
   Sheet col  J = Overlay           (sheet col 10)
   Sheet col  K = Born Alive        (sheet col 11, array index 9)
   Sheet col  L = Total Birth Weight
   Sheet col  M = Date Weaned
   Sheet col  N = Number Weaned     (array index 12 when START_COL=2)//   Sheet col  O = Date Killed
   Sheet col  P = Number Sent To Abattoir

 Column reference (Sow Management Database):
   Sheet col  A = Sow Id            (array index 0)
   Sheet col  F = Date Mated        (array index 5)
   Sheet col  G = Actual Farrowing  (array index 6)
   Sheet col  H = Date Weaned       (array index 7)
*/ 

// ── SHARED HELPER ────────────────────────────────────────────
// Converts any cell value (Date object, serial number, or string) to a
// JavaScript Date. Returns null if the value cannot be parsed.
function normalizeDate(value) {
  // Already a valid JS Date
  if (value instanceof Date && !isNaN(value)) return value;

  // Google Sheets serial number (days since 30 Dec 1899)
  if (typeof value === 'number') {
    const ms = Math.round((value - 25569) * 86400 * 1000);
    const d = new Date(ms);
    return isNaN(d) ? null : d;
  }

  // String date
  if (typeof value === 'string') {
    const s = value.trim().toLowerCase();
    // Ignore blank, dashes, and special notes
    if (!s || s === '-' || s.includes('out') || s.includes('foster')) return null;

    // Try dd/mm/yyyy or dd-mm-yyyy
    const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
    if (m) {
      const d  = parseInt(m[1], 10);
      const mo = parseInt(m[2], 10) - 1;
      let   y  = parseInt(m[3], 10);
      if (y < 100) y += 2000;
      const dt = new Date(y, mo, d);
      return isNaN(dt) ? null : dt;
    }

    // Fallback to JS native parser
    const dt = new Date(value);
    return isNaN(dt) ? null : dt;
  }

  return null;
}

// ── KPI 1 — Litters per Sow per Year (LSY) → D6 ─────────────
// Formula: litters in last 12 months / active sow inventory
// Active sow inventory = unique sows that farrowed at least once in the window

function updateKPI1_LittersPerSowPerYear() {
  const ss    = SpreadsheetApp.getActive();
  const lmd   = ss.getSheetByName('Litter Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!lmd || !bench) throw new Error('Sheet not found.');

  const START_ROW = 2;
  const START_COL = 2;  // col B
  const NUM_COLS  = 19;
  const lastRow   = lmd.getLastRow();

  if (lastRow < START_ROW) {
    bench.getRange('D6').setValue('—');
    bench.getRange('H6').setValue('—');
    bench.getRange('I6').setValue('—');
    return;
  }

  // Use header row to find columns by name — resilient to column moves
  const headers  = lmd.getRange(1, START_COL, 1, NUM_COLS).getValues()[0];
  const IDX_SOW  = headers.indexOf('Sow Number');
  const IDX_DOB  = headers.indexOf('D.O.B');
  if (IDX_SOW === -1 || IDX_DOB === -1) throw new Error('Required columns missing.');

  const data = lmd.getRange(START_ROW, START_COL, lastRow - START_ROW + 1, NUM_COLS).getValues();

  const now             = new Date();
  const twelveMonthsAgo = new Date(now);
  twelveMonthsAgo.setFullYear(now.getFullYear() - 1);

  const recentLittersBySow = {};
  for (const row of data) {
    const sowId = String(row[IDX_SOW] ?? '').trim();
    const dob   = normalizeDate(row[IDX_DOB]);
    if (!sowId || !dob) continue;
    if (dob >= twelveMonthsAgo && dob <= now) {
      recentLittersBySow[sowId] = (recentLittersBySow[sowId] || 0) + 1;
    }
  }

  const activeSowCount = Object.keys(recentLittersBySow).length;
  if (activeSowCount === 0) {
    bench.getRange('D6').setValue('—');
    bench.getRange('H6').setValue('—');
    bench.getRange('I6').setValue('—');
    return;
  }

  const totalRecentLitters = Object.values(recentLittersBySow).reduce((s, n) => s + n, 0);
  const lsy = totalRecentLitters / activeSowCount;
  bench.getRange('D6').setValue(lsy).setNumberFormat('0.0');

  // Rank sows by litter count — more litters = better
  const sowRanking = Object.entries(recentLittersBySow)
    .map(([sowId, count]) => ({ sowId, value: count }))
    .sort((a, b) => b.value - a.value);

  bench.getRange('H6').setValue(sowRanking.slice(0, 3).map(s => s.sowId).join(', ') || '—');
  bench.getRange('I6').setValue(sowRanking.slice(-3).map(s => s.sowId).join(', ') || '—');
}

// ── KPI 2 — Total Pigs Born per Litter → D7 ──────────────────
// Formula: average of Total Born column across all litters
function calculateTotalPigsBornPerLitter() {
  const ss    = SpreadsheetApp.getActive();
  const lmd   = ss.getSheetByName('Litter Management Database');
  const bench = ss.getSheetByName('Benchmark');
  if (!lmd || !bench) throw new Error('Sheet not found.');

  const lastRow = lmd.getLastRow();
  if (lastRow < 2) {
    bench.getRange('D7').setValue('—');
    bench.getRange('H7').setValue('—');
    bench.getRange('I7').setValue('—');
    return;
  }

  // Sheet col G = Total Born = sheet column index 7
  const rawTotals = lmd.getRange(2, 7, lastRow - 1, 1).getValues().flat();

  // Filter out blanks, non-numeric, and zeros
  const totalNums = rawTotals
    .map(v => (v === null || v === undefined || v === '') ? NaN : Number(v))
    .filter(n => !isNaN(n) && n !== 0);

  if (totalNums.length === 0) {
    bench.getRange('D7').setValue('—');
  } else {
    const globalAvg = totalNums.reduce((a, b) => a + b, 0) / totalNums.length;
    bench.getRange('D7').setValue(globalAvg).setNumberFormat('0');
  }

  // Per-sow averages for ranking
  const sowIds = lmd.getRange(2, 2, lastRow - 1, 1).getValues().flat(); // col B
  const perSow = {};

  for (let i = 0; i < sowIds.length; i++) {
    const sowId = String(sowIds[i] ?? '').trim();
    if (!sowId) continue;
    const num = Number(rawTotals[i]);
    if (isNaN(num)) continue;
    if (!perSow[sowId]) perSow[sowId] = [];
    perSow[sowId].push(num);
  }

  const perSowAverages = Object.entries(perSow)
    .map(([sowId, arr]) => ({ sowId, value: arr.reduce((a, b) => a + b, 0) / arr.length }))
    .sort((a, b) => b.value - a.value); // higher = better

  if (perSowAverages.length === 0) {
    bench.getRange('H7').setValue('—');
    bench.getRange('I7').setValue('—');
    return;
  }

  bench.getRange('H7').setValue(perSowAverages.slice(0, 3).map(s => s.sowId).join(', ') || '—');
  bench.getRange('I7').setValue(perSowAverages.slice(-3).map(s => s.sowId).join(', ') || '—');
}

