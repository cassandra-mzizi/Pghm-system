// KPI 7 — Non-productive sow days - D12 

function updateKPI7NonProductiveSowDays() {
  const ss = SpreadsheetApp.getActive();
  const SMD_SHEET_NAME = 'Sow Management Database';
  const BENCH_SHEET_NAME = 'Benchmark';

  const smd = ss.getSheetByName(SMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!smd || !bench) throw new Error('Required sheet not found.');

  const HEADER_ROW = 1;
  const START_ROW = 2;

  // Columns by letter
  const COL_SOW = "B";
  const COL_MATED = "F";
  const COL_FARROWED = "G";
  const COL_WEANED = "H";

  const lastRow = smd.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange("D12").setValue("—");
    return;
  }

  // Get values
  const sows = smd.getRange(`${COL_SOW}${START_ROW}:${COL_SOW}${lastRow}`).getValues().flat();
  const matings = smd.getRange(`${COL_MATED}${START_ROW}:${COL_MATED}${lastRow}`).getValues().flat();
  const farrowings = smd.getRange(`${COL_FARROWED}${START_ROW}:${COL_FARROWED}${lastRow}`).getValues().flat();
  const weanings = smd.getRange(`${COL_WEANED}${START_ROW}:${COL_WEANED}${lastRow}`).getValues().flat();

  let intervals = [];
  let sowIntervals = {}; // store intervals per sow for top/bottom

  for (let i = 0; i < sows.length; i++) {
    const sowId = sows[i];
    const mated = normalizeDate(matings[i]);
    const farrowed = normalizeDate(farrowings[i]);
    const weaned = normalizeDate(weanings[i]);

    let interval = null;

    // Case 1: Weaned -> Next Mating
    if (weaned && mated && mated > weaned) {
      interval = (mated - weaned) / 86400000;
    }

    // Case 2: Mating failed -> Next Mating (no farrow, but later mating)
    if (!interval && mated && !farrowed) {
      for (let j = i + 1; j < matings.length; j++) {
        const nextMating = normalizeDate(matings[j]);
        if (nextMating && nextMating > mated) {
          interval = (nextMating - mated) / 86400000;
          break;
        }
      }
    }

    if (interval !== null && interval >= 0) {
      intervals.push(interval);
      if (!sowIntervals[sowId]) sowIntervals[sowId] = [];
      sowIntervals[sowId].push(interval);
    }
  }

  // Calculate average
  const avgNPD = intervals.length > 0
    ? intervals.reduce((a, b) => a + b, 0) / intervals.length
    : 0;

  bench.getRange("D12").setValue(avgNPD).setNumberFormat('0');

  // Calculate top 3 and worst 3 per-sow average
  const perSowAvg = Object.entries(sowIntervals).map(([sowId, arr]) => {
    const avg = arr.reduce((a, b) => a + b, 0) / arr.length;
    return { sowId, avg };
  });

  perSowAvg.sort((a, b) => b.avg - a.avg); // descending for worst first

  const worst3 = perSowAvg.slice(0, 3).map(o => o.sowId).join(", ");
