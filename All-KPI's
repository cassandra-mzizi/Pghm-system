// KPI 4 — Pre-weaning mortality - D9

function calculatePreWeaningMortality() {
  const ss = SpreadsheetApp.getActive();
  const LMD_SHEET_NAME = "Litter Management Database";
  const BENCH_SHEET_NAME = "Benchmark";

  const lmd = ss.getSheetByName(LMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!lmd || !bench) throw new Error("Required sheet not found.");

  const lastRow = lmd.getLastRow();
  if (lastRow < 2) {
    bench.getRange("D9").setValue("—");
    bench.getRange("H9").setValue("—");
    bench.getRange("I9").setValue("—");
    return;
  }

  // Columns: B = Sow Number (2), G = Total Born (7), H = Dead (8), I = Mummified (9)
  const sowIds = lmd.getRange(2, 2, lastRow - 1, 1).getValues().flat();
  const totalBornVals = lmd.getRange(2, 7, lastRow - 1, 1).getValues().flat();
  const deadVals = lmd.getRange(2, 8, lastRow - 1, 1).getValues().flat();
  const mummifiedVals = lmd.getRange(2, 9, lastRow - 1, 1).getValues().flat();

  // --- Herd-wide mortality ---
  const bornNums = totalBornVals.map(Number).filter(v => !isNaN(v) && v > 0);
  const deadNums = deadVals.map(Number).filter(v => !isNaN(v));
  const mummifiedNums = mummifiedVals.map(Number).filter(v => !isNaN(v));

  const bornSum = bornNums.reduce((a, b) => a + b, 0);
  const deadSum = deadNums.reduce((a, b) => a + b, 0);
  const mummifiedSum = mummifiedNums.reduce((a, b) => a + b, 0);

  const mortality = bornSum > 0 ? ((deadSum + mummifiedSum) / bornSum) * 100 : 0;
  bench.getRange("D9").setValue(mortality).setNumberFormat('0.0"%"');

  // --- Per-sow mortality ---
  const perSow = {};
  for (let i = 0; i < sowIds.length; i++) {
    const sidRaw = sowIds[i];
    const born = Number(totalBornVals[i]);
    const dead = Number(deadVals[i]);
    const mummified = Number(mummifiedVals[i]);

    if (!sidRaw || isNaN(born) || born <= 0) continue;

    const sowId = String(sidRaw).trim();
    if (!perSow[sowId]) perSow[sowId] = { born: 0, dead: 0, mummified: 0 };

    perSow[sowId].born += born;
    perSow[sowId].dead += isNaN(dead) ? 0 : dead;
    perSow[sowId].mummified += isNaN(mummified) ? 0 : mummified;
  }

  const perSowMortality = Object.entries(perSow).map(([sowId, obj]) => {
    const m = ((obj.dead + obj.mummified) / obj.born) * 100;
    return { sowId, value: m };
  });

  if (perSowMortality.length === 0) {
    bench.getRange("H9").setValue("—");
    bench.getRange("I9").setValue("—");
    return;
  }

  // Best = lowest mortality, Worst = highest mortality
  perSowMortality.sort((a, b) => a.value - b.value);

  const best3 = perSowMortality.slice(0, 3).map(s => `${s.sowId} (${s.value.toFixed(1)}%)`).join("\n");
  const worst3 = perSowMortality.slice(-3).map(s => `${s.sowId} (${s.value.toFixed(1)}%)`).join("\n");

  bench.getRange("H9").setValue(best3 || "—");
  bench.getRange("I9").setValue(worst3 || "—");
}



// KPI 5 — Weaned pigs per sow per year - D10 (depends on KPI 1, 3, and 4 already being updated)

function updateKPI5_WeanedPigsPerSowPerYear() {
  const ss = SpreadsheetApp.getActive();

  const LMD_SHEET_NAME = 'Litter Management Database';
  const BENCH_SHEET_NAME = 'Benchmark';

  const lmd = ss.getSheetByName(LMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!lmd || !bench) throw new Error('Required sheet not found.');

  const START_ROW = 2;
  const START_COL = 2;   // B
  const NUM_COLS = 18;   // B..S

  const IDX_SOW = 0;        // B relative to B
  const IDX_BORN_ALIVE = 8; // J
  const IDX_WEANED = 11;    // M

  const lastRow = lmd.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange('D10').setValue('—');
    bench.getRange('H10').setValue('—');
    bench.getRange('I10').setValue('—');
    return;
  }

  const numRows = lastRow - START_ROW + 1;
  const data = lmd.getRange(START_ROW, START_COL, numRows, NUM_COLS).getValues();

  // --- Aggregate by sow ---
  const perSow = {};
  for (const row of data) {
    const sowIdRaw = row[IDX_SOW];
    const weanedRaw = row[IDX_WEANED];
    const bornAliveRaw = row[IDX_BORN_ALIVE];

    if (!sowIdRaw || isNaN(weanedRaw) || isNaN(bornAliveRaw) || bornAliveRaw <= 0) continue;

    const sowId = String(sowIdRaw).trim();
    const weaned = Number(weanedRaw);

    if (!perSow[sowId]) perSow[sowId] = { totalWeaned: 0, litters: 0 };
    perSow[sowId].totalWeaned += weaned;
    perSow[sowId].litters++;
  }

  // --- Calculate herd avg ---
  let herdTotalWeaned = 0;
  let herdTotalLitters = 0;
  for (const s of Object.values(perSow)) {
    herdTotalWeaned += s.totalWeaned;
    herdTotalLitters += s.litters;
  }

  if (herdTotalLitters === 0) {
    bench.getRange('D10').setValue('—');
    return;
  }

  const avgWeanedPerLitter = herdTotalWeaned / herdTotalLitters;
  const littersPerSowPerYear = parseFloat(bench.getRange('D6').getValue()) || 0;

  const herdWeanedPerSowPerYear = avgWeanedPerLitter * littersPerSowPerYear;

  // --- Write herd avg to D10 ---
  bench.getRange('D10').setValue(herdWeanedPerSowPerYear).setNumberFormat('0');

  // --- Per-sow performance ---
  const perSowPerf = Object.entries(perSow).map(([sowId, obj]) => {
    const avgWeaned = obj.totalWeaned / obj.litters;
    const weanedPerYear = avgWeaned * littersPerSowPerYear;
    return { sowId, value: weanedPerYear };
  });

  // --- Rank best/worst ---
  perSowPerf.sort((a, b) => b.value - a.value);

 /* const best3 = perSowPerf.slice(0, 3).map(s => `${s.sowId} (${s.value.toFixed(1)})`).join(", ");
  const worst3 = perSowPerf.slice(-3).map(s => `${s.sowId} (${s.value.toFixed(1)})`).join(", ");

  bench.getRange('H10').setValue(best3 || "—");
  bench.getRange('I10').setValue(worst3 || "—");
  */
  const best3 = perSowPerf.slice(0, 3).map(s => `${s.sowId} (${s.value.toFixed(1)})`).join("\n");
  const worst3 = perSowPerf.slice(-3).map(s => `${s.sowId} (${s.value.toFixed(1)})`).join("\n");

  bench.getRange('H10').setValue(best3 || "—").setWrap(true);   
  bench.getRange('I10').setValue(worst3 || "—").setWrap(true);

}


// KPI 6 — Farrowing rate - D11

function updateKPI6_FarrowingRate() {
  const ss = SpreadsheetApp.getActive();

  const SMD_SHEET_NAME = 'Sow Management Database';
  const BENCH_SHEET_NAME = 'Benchmark';

  const smd = ss.getSheetByName(SMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!smd || !bench) throw new Error('Required sheet not found.');

  const START_ROW = 2;
  const START_COL = 1;   // A
  const NUM_COLS = 31;   // A..AE

  const IDX_SOW = 1;       // B = Sow Number (A=0 → B=1)
  const IDX_MATED = 5;     // F
  const IDX_FARROWED = 6;  // G

  const lastRow = smd.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange('D11').setValue('—');
    bench.getRange('H11').setValue('—');
    bench.getRange('I11').setValue('—');
    return;
  }

  const numRows = lastRow - START_ROW + 1;
  const data = smd.getRange(START_ROW, START_COL, numRows, NUM_COLS).getValues();

  const perSow = {};
  let totalMatings = 0, totalFarrowings = 0;

  for (const row of data) {
    const sowId = row[IDX_SOW];
    const mated = normalizeDate(row[IDX_MATED]);
    const farrowed = normalizeDate(row[IDX_FARROWED]);

    if (!sowId) continue;
    const id = String(sowId).trim();

    if (!perSow[id]) perSow[id] = { matings: 0, farrowings: 0 };

    if (mated) {
      perSow[id].matings++;
      totalMatings++;
    }
    if (farrowed) {
      perSow[id].farrowings++;
      totalFarrowings++;
    }
  }

  const herdRate = totalMatings > 0 ? (totalFarrowings / totalMatings) * 100 : 0;
  bench.getRange('D11').setValue(herdRate).setNumberFormat('0.0"%"');

  // per-sow rates
  const perf = Object.entries(perSow)
    .filter(([id, v]) => v.matings > 0)
    .map(([id, v]) => ({ sowId: id, value: (v.farrowings / v.matings) * 100 }));

  if (perf.length === 0) {
    bench.getRange('H11').setValue('—');
    bench.getRange('I11').setValue('—');
    return;
  }

  perf.sort((a, b) => b.value - a.value);

  const best3 = perf.slice(0, 3).map(s => `${s.sowId} (${s.value.toFixed(1)}%)`).join("\n");
  const worst3 = perf.slice(-3).map(s => `${s.sowId} (${s.value.toFixed(1)}%)`).join("\n");

  bench.getRange('H11').setValue(best3 || "—");
  bench.getRange('I11').setValue(worst3 || "—");
}

