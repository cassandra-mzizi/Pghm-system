  const data = smd.getRange(START_ROW, START_COL, numRows, NUM_COLS).getValues();

  let matings = 0;
  let farrowings = 0;

  for (const row of data) {
    const mated = normalizeDate(row[IDX_MATED]);
    const farrowed = normalizeDate(row[IDX_FARROWED]);

    if (mated) matings++;       // count all matings
    if (farrowed) farrowings++; // count all farrowings
  }

  const rate = matings > 0 ? (farrowings / matings) * 100 : 0;

  // ----- Write result -----
  bench.getRange('D11').setValue(rate).setNumberFormat('0.00"%"');
}

