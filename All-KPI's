// KPI 1 — Litters per sow per year - D6

function updateKPI1_LittersPerSowPerYear() {
  const ss = SpreadsheetApp.getActive();

  const LMD_SHEET_NAME = 'Litter Management Database';
  const BENCH_SHEET_NAME = 'Benchmark';

  const lmd = ss.getSheetByName(LMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!lmd) throw new Error('Sheet "Litter Management Database" not found.');
  if (!bench) throw new Error('Sheet "Benchmark" not found.');

  const HEADER_ROW = 1;
  const START_ROW = 2;                // first data row
  const START_COL = 2;                // column B
  const NUM_COLS = 18;                // B..S

  const lastRow = lmd.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange('D6').setValue('—');
    return;
  }

  // Pull headers and data
  const headers = lmd.getRange(HEADER_ROW, START_COL, 1, NUM_COLS).getValues()[0];
  const data = lmd.getRange(START_ROW, START_COL, lastRow - START_ROW + 1, NUM_COLS).getValues();

  // Find column indices by header names
  const IDX_SOW = headers.indexOf("Sow Number");
  const IDX_DOB = headers.indexOf("D.O.B");

  if (IDX_SOW === -1) throw new Error('"Sow Number" column not found in Litter Management Database.');
  if (IDX_DOB === -1) throw new Error('"D.O.B" column not found in Litter Management Database.');

  // Collect farrowing dates by sow
  const farrowingsBySow = {};
  for (const row of data) {
    const sowCell = row[IDX_SOW];
    const dobCell = row[IDX_DOB];

    if (!sowCell || !dobCell) continue;

    const sowId = String(sowCell).trim();
    const dob = normalizeDate(dobCell);
    if (!sowId || !dob) continue;

    if (!farrowingsBySow[sowId]) farrowingsBySow[sowId] = [];
    farrowingsBySow[sowId].push(dob);
  }

  // Compute per-sow LPY
  const perSowLPY = [];
  for (const [sowId, dates] of Object.entries(farrowingsBySow)) {
    if (dates.length < 2) continue;

    dates.sort((a, b) => a - b);
    const gaps = [];
    for (let i = 1; i < dates.length; i++) {
      const days = (dates[i] - dates[i - 1]) / 86400000;
      if (days >= 100 && days <= 190) gaps.push(days);
    }
    if (gaps.length === 0) continue;

    const avgIFP = gaps.reduce((a, b) => a + b, 0) / gaps.length;
    const lpy = 365 / avgIFP;
    perSowLPY.push(lpy);
  }

  // Herd average
  const herdLPY = perSowLPY.length > 0 
    ? perSowLPY.reduce((a, b) => a + b, 0) / perSowLPY.length 
    : 0;

  // Write to Benchmark!D8
  bench.getRange('D6').setValue(herdLPY).setNumberFormat('0.00');
}
 //Robustly convert assorted cell contents to a Date or return null.

function normalizeDate(value) {
  if (value instanceof Date && !isNaN(value)) return value;

  if (typeof value === 'number') {
    const ms = Math.round((value - 25569) * 86400 * 1000);
    const d = new Date(ms);
    return isNaN(d) ? null : d;
  }

  if (typeof value === 'string') {
    const s = value.trim().toLowerCase();
    if (!s || s === '-' || s.includes('out') || s.includes('foster')) return null;

    const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
    if (m) {
      const d = parseInt(m[1], 10);
      const mo = parseInt(m[2], 10) - 1;
      let y = parseInt(m[3], 10);
      if (y < 100) y += 2000;
      const dt = new Date(y, mo, d);
      return isNaN(dt) ? null : dt;
    }

    const dt = new Date(value);
    return isNaN(dt) ? null : dt;
  }

  return null;
}

// KPI 2 — Total pigs born per litter - D7

function calculateTotalPigsBornPerLitter() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Litter Management Database");
  const totalBorn = sheet.getRange("G2:G" + sheet.getLastRow()).getValues().flat().filter(Number);

  if (totalBorn.length === 0) return;

  const avgBorn = totalBorn.reduce((a, b) => a + b, 0) / totalBorn.length;

  SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName("Benchmark")
    .getRange("D7").setValue(avgBorn.toFixed(2));
}

// KPI 3 — Pigs born alive per litter - D8 

function calculatePigsBornAlivePerLitter() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Litter Management Database");
  const bornAlive = sheet.getRange("J2:J" + sheet.getLastRow()).getValues().flat().filter(Number);

  if (bornAlive.length === 0) return;

  const avgAlive = bornAlive.reduce((a, b) => a + b, 0) / bornAlive.length;

  SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName("Benchmark")
    .getRange("D8").setValue(avgAlive.toFixed(2));
}

// KPI 4 — Pre-weaning mortality - D9
 function calculatePreWeaningMortality() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Litter Management Database");
  const totalBorn = sheet.getRange("G2:G" + sheet.getLastRow()).getValues().flat().filter(Number);
  const numberWeaned = sheet.getRange("M2:M" + sheet.getLastRow()).getValues().flat().filter(Number);

  if (totalBorn.length === 0 || numberWeaned.length === 0) return;

  const bornSum = totalBorn.reduce((a, b) => a + b, 0);
  const weanedSum = numberWeaned.reduce((a, b) => a + b, 0);
  const mortality = ((bornSum - weanedSum) / bornSum) * 100;

  SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName("Benchmark")
    .getRange("D9").setValue(mortality.toFixed(2) + "%");
}

// KPI 5 — Weaned pigs per sow per year - D10
  // (depends on KPI 1, 3, and 4 already being updated)

function updateKPI5_WeanedPigsPerSowPerYear() {
  const ss = SpreadsheetApp.getActive();

  // ----- Sheets -----
  const LMD_SHEET_NAME = 'Litter Management Database';
  const BENCH_SHEET_NAME = 'Benchmark';

  const lmd = ss.getSheetByName(LMD_SHEET_NAME);
  const bench = ss.getSheetByName(BENCH_SHEET_NAME);
  if (!lmd || !bench) throw new Error('Required sheet not found.');

  // ----- Fixed layout in LMD: columns B:S -----
  // B = Sow Number
  // F = D.O.B
  // J = Born Alive
  // M = Number Weaned
  const HEADER_ROW = 1;
  const START_ROW = 2;
  const START_COL = 2;   // B
  const NUM_COLS = 18;   // B..S

  const IDX_SOW = 0;     // B relative to B
  const IDX_DOB = 4;     // F relative to B
  const IDX_BORN_ALIVE = 8; // J relative to B
  const IDX_WEANED = 11; // M relative to B

  const lastRow = lmd.getLastRow();
  if (lastRow < START_ROW) {
    bench.getRange('D12').setValue('—');
    return;
  }

  const numRows = lastRow - START_ROW + 1;
  const data = lmd.getRange(START_ROW, START_COL, numRows, NUM_COLS).getValues();

  // ----- Collect weaned pigs -----
  let totalWeaned = 0;
  let totalLitters = 0;

  for (const row of data) {
    const bornAlive = parseFloat(row[IDX_BORN_ALIVE]);
    const weaned = parseFloat(row[IDX_WEANED]);

    if (!isNaN(bornAlive) && !isNaN(weaned) && bornAlive > 0 && weaned >= 0) {
      totalWeaned += weaned;
      totalLitters++;
    }
  }

  if (totalLitters === 0) {
    bench.getRange('D10').setValue('—');
    return;
  }

  const avgWeanedPerLitter = totalWeaned / totalLitters;

  // ----- Get Litters per sow per year from Benchmark!D8 -----
  const littersPerSowPerYear = parseFloat(bench.getRange('D8').getValue()) || 0;

  // ----- Calculate KPI -----
  const weanedPerSowPerYear = avgWeanedPerLitter * littersPerSowPerYear;

  // ----- Write result -----
  bench.getRange('D10').setValue(weanedPerSowPerYear).setNumberFormat('0.00');
}

