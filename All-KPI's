// ── GENERATE PDF ──────────────────────────────────────────────
// Exports the Benchmark sheet as a PDF saved to Drive > Report > Benchmark
function generateBenchmarkPDF() {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Benchmark');
  const ui    = SpreadsheetApp.getUi();
  if (!sheet) return ui.alert("Sheet 'Benchmark' not found.");

  const userChoice = ui.alert(
    'Generate Benchmark Report?',
    'Would you like to generate the Benchmark PDF report now?',
    ui.ButtonSet.YES_NO
  );
  if (userChoice === ui.Button.NO) {
    ui.alert('Thank you for using the Benchmarking System.');
    return;
  }

  const headerRow = 5;
  const startRow  = headerRow + 1;
  const lastRow   = sheet.getLastRow();
  const numRows   = lastRow - startRow + 1;
  if (numRows <= 0) return ui.alert('No KPI data found below the header row.');

  const colKPI     = 3; // C
  const range      = sheet.getRange(startRow, colKPI, numRows, 7);
  const values     = range.getDisplayValues();
  const richValues = range.getRichTextValues();

  // Create a Google Doc to build the PDF from
  const today       = new Date();
  const headingDate = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(today);
  const doc         = DocumentApp.create(`Benchmark Report - ${headingDate}`);
  const body        = doc.getBody();

  body.appendParagraph('Benchmark Report')
    .setAlignment(DocumentApp.HorizontalAlignment.CENTER)
    .setFontSize(22).setBold(true);
  body.appendParagraph(headingDate)
    .setAlignment(DocumentApp.HorizontalAlignment.CENTER)
    .setFontSize(12);
  body.appendParagraph('');
  body.appendParagraph('This report contains KPI values, targets, status, and recommendations from the Benchmark sheet.')
    .setFontSize(11).setSpacingAfter(8);

  // Build table with headers
  const headers = ['KPI', 'Your Current Value', 'Target', 'Status', 'Recommendation', 'Best Sows', 'Worst Sows'];
  const table   = body.appendTable();
  const hr      = table.appendTableRow();
  headers.forEach(h => {
    hr.appendTableCell(h)
      .setBackgroundColor('#e6e6e6').setBold(true).setFontSize(11)
      .setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER)
      .setPaddingTop(4).setPaddingBottom(4);
  });

  // Populate table rows
  values.forEach((row, rIdx) => {
    if (!row[0]) return; // skip empty rows
    const tr = table.appendTableRow();
    row.forEach((cellVal, cIdx) => {
      const cell = tr.appendTableCell();
      cell.setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER)
          .setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(4).setPaddingRight(4);

      const para    = cell.appendParagraph('');
      const textEl  = para.editAsText().setFontSize(11);
      const text    = cellVal || '—';

      // Recommendation column (index 4) — preserve rich text links if present
      if (cIdx === 4) {
        const rich = richValues[rIdx][cIdx];
        if (rich) {
          const richText = rich.getText() || '';
          textEl.setText(richText);
          // Note: Apps Script RichTextValue does not expose getRuns()
          // Links within recommendation text are not transferred to the Doc
          // To add links, manually set them in generateRecommendations() using setLinkUrl()
        } else {
          textEl.setText(text);
        }
      } else {
        textEl.setText(text);
      }
    });
  });

  // Save doc, export as PDF, trash the temp doc
  doc.saveAndClose();
  const pdfBlob = DriveApp.getFileById(doc.getId())
    .getAs(MimeType.PDF)
    .setName(`Benchmark Report - ${headingDate}.pdf`);

  // Save into Drive > Report > Benchmark (creates folders if needed)
  let reportFolder    = DriveApp.getFoldersByName('Report');
  reportFolder        = reportFolder.hasNext() ? reportFolder.next() : DriveApp.createFolder('Report');
  let benchmarkFolder = reportFolder.getFoldersByName('Benchmark');
  benchmarkFolder     = benchmarkFolder.hasNext() ? benchmarkFolder.next() : reportFolder.createFolder('Benchmark');

  const pdfFile = benchmarkFolder.createFile(pdfBlob);
  DriveApp.getFileById(doc.getId()).setTrashed(true); // clean up temp doc

  const html = HtmlService.createHtmlOutput(
    `<p><b>✅ Benchmark PDF generated successfully!</b></p>
     <p>File: <code>${pdfFile.getName()}</code><br>
     Location: <b>Report / Benchmark</b></p>
     <p><a href="${pdfFile.getUrl()}" target="_blank">📄 Click here to open the PDF</a></p>`
  ).setWidth(400).setHeight(200);
  ui.showModalDialog(html, 'Benchmark Report Created');
}

