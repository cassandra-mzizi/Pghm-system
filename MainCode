    `Would you like to transfer this data to the Litter Management Database?\n\n${data}`,
    ui.ButtonSet.YES_NO
  );

  if (response == ui.Button.NO) {
    ui.alert("Okay, your transfer has been cancelled.");
    return;
  }

  const lastRow = targetSheet.getLastRow();
  let normalizedLitterIds = [];
  let duplicateRowIndex = -1;

  if (lastRow > 1) {
    // FIX: Read from correct column E (column position 5)
    const litterIds = targetSheet.getRange(2, 5, lastRow - 1, 1).getDisplayValues().flat();
    normalizedLitterIds = litterIds.map(String);
    duplicateRowIndex = normalizedLitterIds.indexOf(String(litterId));
  }

  if (duplicateRowIndex !== -1) {
    const rowToOverwrite = duplicateRowIndex + 2; // Adjust for header
    const overwriteResponse = ui.alert(
      `Duplicate found for Litter ID: ${litterId} in row ${rowToOverwrite}. Do you want to overwrite the existing data?`,
      ui.ButtonSet.YES_NO
    );

    if (overwriteResponse == ui.Button.NO) {
      ui.alert("Transfer cancelled. No changes were made.");
      return;
    }

    try {
      targetSheet.getRange(rowToOverwrite, 2).setValue(sowId);       // Column B
      targetSheet.getRange(rowToOverwrite, 3).setValue(parity);      // Column C
      targetSheet.getRange(rowToOverwrite, 4).setValue(boarId);      // Column D
      targetSheet.getRange(rowToOverwrite, 5).setValue(litterId);    // Column E
      targetSheet.getRange(rowToOverwrite, 6).setValue(dob);         // Column F
      targetSheet.getRange(rowToOverwrite, 13).setValue(dateWeaned); // Column M 

      ui.alert(`The existing data for Litter ID: ${litterId} has been overwritten.`);
    } catch (e) {
      Logger.log(`Error while overwriting row ${rowToOverwrite}: ${e}`);
      ui.alert(`An error occurred while updating the existing entry: ${e.message}`);
    }

    return;
  }

  // FIX: Find first empty row by checking if Column E (Litter ID) is empty
  let nextRow = lastRow + 1;
  if (lastRow > 1) {
    const allLitterIds = targetSheet.getRange(2, 5, lastRow - 1, 1).getValues().flat();
    for (let i = 0; i < allLitterIds.length; i++) {
      if (String(allLitterIds[i]).trim() === "") {
        nextRow = i + 2; // Convert 0-based array index to 1-based row number (accounting for header)
        break;
      }
    }
  }

  // No duplicate found, write to next available row
  targetSheet.getRange(nextRow, 2).setValue(sowId);        // Column B
  targetSheet.getRange(nextRow, 3).setValue(parity);       // Column C
  targetSheet.getRange(nextRow, 4).setValue(boarId);       // Column D
  targetSheet.getRange(nextRow, 5).setValue(litterId);     // Column E
  targetSheet.getRange(nextRow, 6).setValue(dob);          // Column F
  targetSheet.getRange(nextRow, 13).setValue(dateWeaned);  // Column M 

  ui.alert(`${data} \nData has been transferred to "Litter Management Database".\nPlease use Litter ID to add missing information.`);
}

