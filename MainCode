// Search Litter
function searchLitter() {
  assertSystemAccess();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var litterFormSheet = ss.getSheetByName('Litter Management Form');
  var litterDatabaseSheet = ss.getSheetByName('Litter Management Database');
  var ui = SpreadsheetApp.getUi();

  // Value to search for (from D4)
  var nameToSearch = litterFormSheet.getRange('D4').getValue();

  var lastRow = litterDatabaseSheet.getLastRow();
  var namesColumn = litterDatabaseSheet.getRange('E1:E' + lastRow).getValues();
  var foundRowIndex = -1;

  // Check for matching Litter ID in column E
  for (var i = 0; i < namesColumn.length; i++) {
    if (String(namesColumn[i][0]).trim() === String(nameToSearch).trim()) {
      foundRowIndex = i + 1;
      break;
    }
  }

  if (foundRowIndex !== -1) {
    var rowData = litterDatabaseSheet.getRange(foundRowIndex, 2, 1, litterDatabaseSheet.getLastColumn() - 1).getValues()[0];

    // LEFT COLUMN (D column)
    litterFormSheet.getRange('D7').setValue(rowData[0]);    // B → Sow Number
    litterFormSheet.getRange('D9').setValue(rowData[1]);    // C → Parity
    litterFormSheet.getRange('D11').setValue(rowData[2]);   // D → Boar Number
    litterFormSheet.getRange('D13').setValue(rowData[3]);   // E → Litter ID
    litterFormSheet.getRange('D15').setValue(rowData[4]);   // F → D.O.B
    litterFormSheet.getRange('D17').setValue(rowData[5]);   // G → Total Born
    litterFormSheet.getRange('D19').setValue(rowData[6]);   // H → Born Dead
    litterFormSheet.getRange('D21').setValue(rowData[7]);   // I → Mummified
    litterFormSheet.getRange('D23').setValue(rowData[8]);   // J → Overlays & Other causes

    // RIGHT COLUMN (G column)
    litterFormSheet.getRange('G7').setValue(rowData[9]);    // K → Born Alive
    litterFormSheet.getRange('G9').setValue(rowData[10]);   // L → Total Birth Weight
    litterFormSheet.getRange('G11').setValue(rowData[11]);  // M → Date Weaned
    litterFormSheet.getRange('G13').setValue(rowData[12]);  // N → Number Weaned
    litterFormSheet.getRange('G15').setValue(rowData[13]);  // O → Date Killed
    litterFormSheet.getRange('G17').setValue(rowData[14]);  // P → Number Sent To Abattoir
    litterFormSheet.getRange('G19').setValue(rowData[15]);  // Q → Total Carcass Weight
    litterFormSheet.getRange('G21').setValue(rowData[16]);  // R → Age at Slaughter
    litterFormSheet.getRange('G23').setValue(rowData[17]);  // S → Number Sold Live
    
    // Far right
    litterFormSheet.getRange('J7').setValue(rowData[18]);   // T → Total Weight of Stock Sold Live

    ui.alert('Match Found', 'Matching data has been populated in the Results panel.', ui.ButtonSet.OK);
  } else {
    ui.alert('No matching data found', 'No matching data found in the database.', ui.ButtonSet.OK);
  }
}

// Save Litter
function saveLitterData() {
 assertSystemAccess(); 
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sourceSheet = ss.getSheetByName('Litter management Form');
  var targetSheet = ss.getSheetByName('Litter management database');

  var dataToTransfer = [
    sourceSheet.getRange('D7').getValues()[0][0],
    sourceSheet.getRange('D9').getValues()[0][0],
    sourceSheet.getRange('D11').getValues()[0][0],
    sourceSheet.getRange('D13').getValues()[0][0],
    sourceSheet.getRange('D15').getValues()[0][0],
    sourceSheet.getRange('D17').getValues()[0][0],
    sourceSheet.getRange('D19').getValues()[0][0],
    sourceSheet.getRange('D21').getValues()[0][0],
    sourceSheet.getRange('D23').getValues()[0][0],
    sourceSheet.getRange('G7').getValues()[0][0],
    sourceSheet.getRange('G9').getValues()[0][0],
    sourceSheet.getRange('G11').getValues()[0][0],
    sourceSheet.getRange('G13').getValues()[0][0],
    sourceSheet.getRange('G15').getValues()[0][0],
    sourceSheet.getRange('G17').getValues()[0][0],
    sourceSheet.getRange('G19').getValues()[0][0],
    sourceSheet.getRange('G21').getValues()[0][0],
    sourceSheet.getRange('G23').getValues()[0][0],
    sourceSheet.getRange('J7').getValues()[0][0]
  ];
  var identifier = sourceSheet.getRange('D13').getValues()[0][0]; // Check the value in cell "D11"

  // Check for duplicates in column D of the target sheet
  var columnDValues = targetSheet.getRange('E1:E' + targetSheet.getLastRow()).getValues().flat(); // Get all values in column D
  if (columnDValues.includes(identifier)) {
    var ui = SpreadsheetApp.getUi();
    ui.alert('Error', 'Duplicate of found. Data not transferred.', ui.ButtonSet.OK);
    return; // Exit the function if a duplicate is found
  } else {
    // Get the next available row in the target sheet
    var lastRow = targetSheet.getLastRow();
    var targetRange = targetSheet.getRange('B' + (lastRow + 1) + ':T' + (lastRow + 1));

    // Set the values in the target range
    targetRange.setValues([dataToTransfer]);

    var ui = SpreadsheetApp.getUi();
    ui.alert('Success', 'Data saved successfully.', ui.ButtonSet.OK);
  }
}

// Modify Litter
function modifyLitter() {
  assertSystemAccess();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const form = ss.getSheetByName('Litter Management Form');
  const db = ss.getSheetByName('Litter Management Database');
  const ui = SpreadsheetApp.getUi();

  if (!form || !db) {
    ui.alert('Error', 'Required sheet not found.', ui.ButtonSet.OK);
    return;
  }

  // 🔑 Litter ID to match on (FORM D13)
  const litterId = String(form.getRange('D13').getValue()).trim();
  if (!litterId) {
    ui.alert('Error', 'Litter ID (D13) is empty.', ui.ButtonSet.OK);
    return;
  }

  const lastRow = db.getLastRow();
  if (lastRow < 2) {
    ui.alert('Error', 'Database is empty.', ui.ButtonSet.OK);
    return;
  }

  // Column E = Litter ID → index 4
  const litterIds = db.getRange(2, 5, lastRow - 1, 1).getValues().flat();

  // Find all matching rows
  const matches = [];
  litterIds.forEach((id, i) => {
    if (String(id).trim() === litterId) {
      matches.push(i + 2); // real row number
    }
  });

  if (matches.length === 0) {
    ui.alert(
      'Not Found',
      `No record found for Litter ID (${litterId}).`,
      ui.ButtonSet.OK
    );
    return;
  }

  // If duplicates exist, confirm overwrite
  let targetRow = matches[0];
  if (matches.length > 1) {
    const resp = ui.alert(
      'Duplicate Litter IDs Found',
      `There are ${matches.length} entries with Litter ID (${litterId}).\n\nOverwrite the FIRST one (row ${targetRow})?`,
      ui.ButtonSet.YES_NO
    );
    if (resp !== ui.Button.YES) {
      ui.alert('Cancelled', 'No changes were made.', ui.ButtonSet.OK);
      return;
    }
  }

  // Pull values from the form (B–S mapping)
  const valuesFromForm = [
    form.getRange('D7').getValue(),   // Sow Number
    form.getRange('D9').getValue(),   // Parity
    form.getRange('D11').getValue(),  // Boar Number
    form.getRange('D13').getValue(),  // Litter ID
    form.getRange('D15').getValue(),  // DOB
    form.getRange('D17').getValue(),  // Total Born
    form.getRange('D19').getValue(),  // Born Dead
    form.getRange('D21').getValue(),  // Mummified
    form.getRange('D23').getValue(),  // Overlay & Other Causes
    form.getRange('G7').getValue(),   // Born Alive
    form.getRange('G9').getValue(),   // Total Birth Weight
    form.getRange('G11').getValue(),  // Date Weaned
    form.getRange('G13').getValue(),  // Number Weaned
    form.getRange('G15').getValue(),  // Date Killed
    form.getRange('G17').getValue(),  // Number Sent to Abattoir
    form.getRange('G19').getValue(),  // Total Carcass Weight 
    form.getRange('G21').getValue(),  // Age at Slaughter
    form.getRange('G23').getValue(),  // Number Sold Breeding
    form.getRange('J7').getValue()    // Total Weight Sold Live
  ];

  // Confirm update
  const confirm = ui.alert(
    'Confirm Modification',
    `Overwrite existing record for Litter ID (${litterId})?`,
    ui.ButtonSet.YES_NO
  );
  if (confirm !== ui.Button.YES) {
    ui.alert('Cancelled', 'No changes were made.', ui.ButtonSet.OK);
    return;
  }

  // ✅ OVERWRITE EXISTING ROW (B → S)
  db.getRange(targetRow, 2, 1, valuesFromForm.length)
    .setValues([valuesFromForm]);

  ui.alert(
    'Success',
    `Litter ID (${litterId}) updated successfully.`,
    ui.ButtonSet.OK
  );
}

