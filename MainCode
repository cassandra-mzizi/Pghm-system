  if (!getLicenseState()) {
    SpreadsheetApp.getUi().alert("License is not active. Please validate your license.");
    return;
  }
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var litterFormSheet = ss.getSheetByName('Litter Management Form');
  var litterDatabaseSheet = ss.getSheetByName('Litter Management Database');
  var ui = SpreadsheetApp.getUi(); // Get the UI instance

  // Values to search for
  var valueD4 = litterFormSheet.getRange('D4').getValue();
  var valueD11 = litterFormSheet.getRange('D13').getValue();

  var lastRow = litterDatabaseSheet.getLastRow();
  var columnDData = litterDatabaseSheet.getRange('E1:E' + lastRow).getValues();

  var foundRowIndex = -1;
  var duplicateD11RowIndex = -1;

  // Check for matching ID in the database (D4)
  for (var i = 0; i < columnDData.length; i++) {
    if (columnDData[i][0] === valueD4) {
      foundRowIndex = i + 1; // Adding 1 to convert from 0-based index to 1-based row number
    }
    if (columnDData[i][0] === valueD11 && i + 1 !== foundRowIndex) {
      duplicateD11RowIndex = i + 1;
    }
  }

  // Ask for confirmation if there is a duplicate in D11
  if (duplicateD11RowIndex !== -1) {
    var response = ui.alert('Duplicate ID Found', 'Another entry with the same ID as D11 exists. Do you want to overwrite it?', ui.ButtonSet.YES_NO);
    if (response === ui.Button.NO) {
      ui.alert('Modification Cancelled', 'No changes were made.', ui.ButtonSet.OK);
      return;
    }
  }

  if (foundRowIndex !== -1) {
    // Get the values from the form
    var valuesFromForm = [
      litterFormSheet.getRange('D7').getValue(),
      litterFormSheet.getRange('D9').getValue(),
      //valueD4,
      litterFormSheet.getRange('D11').getValue(),
      litterFormSheet.getRange('D13').getValue(),
      litterFormSheet.getRange('D15').getValue(),
      litterFormSheet.getRange('D17').getValue(),
      litterFormSheet.getRange('D19').getValue(),
      litterFormSheet.getRange('D21').getValue(),
      litterFormSheet.getRange('D23').getValue(),
      litterFormSheet.getRange('G7').getValue(),
      litterFormSheet.getRange('G9').getValue(),
      litterFormSheet.getRange('G11').getValue(),
      litterFormSheet.getRange('G13').getValue(),
      litterFormSheet.getRange('G15').getValue(),
      litterFormSheet.getRange('G17').getValue(),
      litterFormSheet.getRange('G19').getValue(),
      litterFormSheet.getRange('G21').getValue(),
      litterFormSheet.getRange('G23').getValue()
    ];

    // Get the old values from the database
    var oldValues = litterDatabaseSheet.getRange(foundRowIndex, 2, 1, valuesFromForm.length).getValues()[0];

    // Track changes
    var changes = [];

    // Overwrite matching row with values from the form
    for (var j = 0; j < valuesFromForm.length; j++) {
      if (valuesFromForm[j] !== oldValues[j]) {
        changes.push(litterDatabaseSheet.getRange(1, j + 2).getA1Notation());
      }
    }

    // Ask for confirmation before making changes
    var confirmation = ui.alert('Confirm Changes', 'Are you sure you want to make these changes?', ui.ButtonSet.YES_NO);
    if (confirmation === ui.Button.NO) {
      ui.alert('Modification Cancelled', 'No changes were made.', ui.ButtonSet.OK);
      return;
    }

    litterDatabaseSheet.getRange(foundRowIndex, 2, 1, valuesFromForm.length).setValues([valuesFromForm]);

    // Show UI alert for successful modification with concise changes
    ui.alert('Success', 'LitterID (' + valueD4 + ') modified successfully.', ui.ButtonSet.OK);
  } else {
    // If no match found, display an error alert
    ui.alert('Error', 'No matching data found in the database. Modification Failed', ui.ButtonSet.OK);
  }
}

