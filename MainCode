    }
  }

  if (foundRowIndex !== -1) {
    var rowData = litterDatabaseSheet.getRange(foundRowIndex, 2, 1, litterDatabaseSheet.getLastColumn() - 1).getValues()[0];

    // Displaying information in respective cells in "Litter Form"
    litterFormSheet.getRange('D7').setValue(rowData[0]); // Assuming the data starts from column B
    litterFormSheet.getRange('D9').setValue(rowData[1]); // Assuming the data in column C
    litterFormSheet.getRange('D11').setValue(rowData[2]); // Assuming the data in column D
    litterFormSheet.getRange('D13').setValue(rowData[3]); // Assuming the data in column E
    litterFormSheet.getRange('D15').setValue(rowData[4]); // Assuming the data in column F
    litterFormSheet.getRange('D17').setValue(rowData[5]); // Assuming the data in column G
    litterFormSheet.getRange('D19').setValue(rowData[6]); // Assuming the data in column H
    litterFormSheet.getRange('D21').setValue(rowData[7]); // Assuming the data in column I
    litterFormSheet.getRange('D23').setValue(rowData[8]); // Assuming the data in column J

    // For the second row
    litterFormSheet.getRange('G7').setValue(rowData[9]); // Assuming the data in column K
    litterFormSheet.getRange('G9').setValue(rowData[10]); // Assuming the data in column L
    litterFormSheet.getRange('G11').setValue(rowData[11]); // Assuming the data in column M
    litterFormSheet.getRange('G13').setValue(rowData[12]); // Assuming the data in column M
    litterFormSheet.getRange('G15').setValue(rowData[13]); // Assuming the data in column O
    litterFormSheet.getRange('G17').setValue(rowData[14]); // Assuming the data in column P
    litterFormSheet.getRange('G19').setValue(rowData[15]); // Assuming the data in column Q
    litterFormSheet.getRange('G21').setValue(rowData[16]); // Assuming the data in column R
    litterFormSheet.getRange('G23').setValue(rowData[17]); // Assuming the data in column S

    // Show UI alert for match found
