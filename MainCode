    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);
}
function getOrdinal(day) {
  if (day > 3 && day < 21) return `${day}th`;
  switch (day % 10) {
    case 1: return `${day}st`;
    case 2: return `${day}nd`;
    case 3: return `${day}rd`;
    default: return `${day}th`;
  }
}

// Print Monthly

function generateMonthlyReporting() {
// Check if license is active
 assertSystemAccess();
// SHEET SETUP
  const SHEET_NAME = 'Sow Management Database';
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
  if (!sheet) {
    console.error(`Error: Sheet '${SHEET_NAME}' not found. Please verify the sheet name.`);
    return;
  }

// UI SETUP
  const ui = SpreadsheetApp.getUi();
  ui.alert('Checking your monthly report…');

// DATE HELPERS 
  const today       = new Date();
  const monthStart  = getStartOfMonth(today);
  const monthEnd    = getEndOfMonth(today);
  const headingDate = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(today);

// ACTIVITY COLUMNS 
  const activityColumns = [
    { name: "FarrowSure (Primary)", cols: [17, null] },
    { name: "FarrowSure (Booster)", cols: [18, 19] },
    { name: "21-day Check OR Scan", cols: [11, 11] },
    { name: "42-day Check", cols: [12, 12] },
    { name: "LitterGuard (Primary)", cols: [13, null] },
    { name: "LitterGuard Booster and Dewormer", cols: [14, 20] },
    { name: "RespiSure (Primary)", cols: [15, 21] },
    { name: "RespiSure Booster", cols: [16, 22] },
    { name: "Move Sow / Gilt into farrowing pen", cols: [9, 9] },
    { name: "Check for Heat post weaning", cols: [30, 30] },
    { name: "Expected Farrowing Date", cols: [8, 8] },
    { name: "Teeth, Tail, Iron, Ear Notching, Castration", cols: [28, 28] },
    { name: "RespiSure-One (piglets)", cols: [23, 23] },
    { name: "RespiSure-2nd (piglets)", cols: [24, 24] },
    //{ name: "Ivermectin Deworming Pre-Farrowing", cols: [27, 25] },
    { name: "Ivermectin Deworming Pre-Mating", cols: [26, null] },
    { name: "Expected Weaning Date", cols: [10, 10] },
    { name: "Flush feeding sow pre-mating", cols: [29, 29] }
  ];

// DATA EXTRACTION 
  const data       = sheet.getDataRange().getValues();
  const activities = [];

  for (let r = 1; r < data.length; r++) {
    const row    = data[r];
    const sowId  = row[0];
    const parity = row[2];

    activityColumns.forEach(({ name, cols: [cA, cB] }) => {
      if (cA === cB) {
        const val = row[cA];
        if (val) processActivity(val, name, sowId, parity);
        return;
      }
      const valA = row[cA];
      const valB = cB !== null ? row[cB] : null;
      if (valA) processActivity(valA, name, sowId, parity);
      if (valB) processActivity(valB, name, sowId, parity);
    });
  }

// PROMPT 
  if (activities.length > 0) {
    const resp = ui.alert(`There are activities for ${headingDate}.\nWould you like me to print the report?`, ui.ButtonSet.YES_NO);
    if (resp === ui.Button.YES) {
      generatePDF(activities, monthStart, monthEnd, headingDate);
    } else {
      ui.alert('PDF cancelled.');
    }
  } else {
    ui.alert('Nothing to do this month.');
  }

// HELPERS 
  function parseDateRange(value) {
    if (value instanceof Date) return [value, value];
    const str = value.toString();
    const parts = str.includes(' Through ')
      ? str.split(' Through ')
      : str.includes(' OR ')
      ? str.split(' OR ')
      : [str];
    const start = toDate(parts[0]);
    const end   = toDate(parts[1] || parts[0]);
    return [start, end];
  }

  function toDate(str) {
    if (!str) return null;
    if (str instanceof Date) return str;
    const parts = str.trim().split('/');
    if (parts.length !== 3) return null;
    return new Date(parts[2], parts[1] - 1, parts[0]);
  }

  function processActivity(value, activityName, sowId, parity) {
    const [rawStart, rawEnd] = parseDateRange(value);
    if (!(rawStart && rawEnd)) return;
    const start = normalizeDate(rawStart);
    const end   = normalizeDate(rawEnd);
    const diffDays = Math.round((end - start) / 86400000);
    const multiday = diffDays > 1;
    const twoDay   = diffDays === 1;
    if (isDateInRange(start, end, monthStart, monthEnd)) {
      activities.push({ date: start, name: activityName, sowId, parity, multiday, twoDay });
    }
  }

  function getStartOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
  function getEndOfMonth(d)   { return new Date(d.getFullYear(), d.getMonth() + 1, 0); }
  function normalizeDate(d)   { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
  function isDateInRange(start, end, rangeStart, rangeEnd) {
    return start <= rangeEnd && end >= rangeStart;
  }

// MATCHES WEEKLY PDF STYLE 
  function generatePDF(acts, startDate, endDate, heading) {
    const doc = DocumentApp.create(`Monthly Report: ${heading}`);
    const body = doc.getBody();

    // Title
    const titlePara = body.appendParagraph('Monthly Report for');
    titlePara.setAlignment(DocumentApp.HorizontalAlignment.CENTER)
             .setFontSize(26)
             .setBold(true);

    // Date Range
    const datePara = body.appendParagraph(`${formatDate(startDate)} - ${formatDate(endDate)}`);
    datePara.setAlignment(DocumentApp.HorizontalAlignment.CENTER)
            .setFontSize(20)
            .setBold(false);

    // Info line
    body.appendParagraph(`ℹ️ This document is intended to be printed and distributed to employees for task management purposes. Please make sure to tick the boxes`)
        .setHeading(DocumentApp.ParagraphHeading.HEADING3)
        .setBold(false);

    // Group by date
    const grouped = {};
    acts.forEach(a => {
      const key = a.date.toDateString();
      (grouped[key] = grouped[key] || []).push(a);
    });

    // Daily sections
    for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
      const key = d.toDateString();
      const dayName = d.toLocaleDateString('en-GB', { weekday: 'long' });
      const dayNumber = getOrdinal(d.getDate());
      const monthName = d.toLocaleDateString('en-GB', { month: 'long' });
      const year = d.getFullYear();
      const formattedDay = `${dayName} ${dayNumber} of ${monthName} ${year}`;

      const dayPara = body.appendParagraph(formattedDay);
      dayPara.setHeading(DocumentApp.ParagraphHeading.HEADING1)
             .setBold(true)
             .setUnderline(true);

      if (grouped[key]) {
        activityColumns.forEach(({ name }) => {
          const matches = grouped[key].filter(a => a.name === name);
          if (matches.length > 0) {
            const activityPara = body.appendParagraph(name);
            activityPara.setHeading(DocumentApp.ParagraphHeading.HEADING2)
                        .setBold(true);
            matches.forEach(a => {
              const symbol = a.multiday ? '*' : a.twoDay ? '^' : '';
              body.appendParagraph(`☐ Sow ID: ${a.sowId} Parity: ${a.parity}${symbol}`)
                  .setBold(false);
            });
          }
        });
      } else {
        body.appendParagraph("Nothing to do today.")
            .setHeading(DocumentApp.ParagraphHeading.HEADING2)
            .setBold(true);
      }
    }

// ADD KEY 
    body.appendParagraph(`* Activities can be done any time this week`)
        .setHeading(DocumentApp.ParagraphHeading.HEADING3)
        .setBold(false);
    body.appendParagraph(`^Activities can happen a day earlier or later than predicted. .`)
        .setHeading(DocumentApp.ParagraphHeading.HEADING3)
        .setBold(false);
    body.appendParagraph(`☐ To be ticked off as tasks are done.`)
        .setHeading(DocumentApp.ParagraphHeading.HEADING3)
        .setBold(false);


    // Save & convert
    doc.saveAndClose();
    const pdfBlob = DriveApp.getFileById(doc.getId())
      .getAs(MimeType.PDF)
      .setName(`Monthly Report: ${formatDate(startDate)} - ${formatDate(endDate)}.pdf`);
    const folder = (() => {
      const f = DriveApp.getFoldersByName('Report');
      return f.hasNext() ? f.next() : DriveApp.createFolder('Report');
    })();
    const pdfFile = folder.createFile(pdfBlob);
    DriveApp.getFileById(doc.getId()).setTrashed(true);
    Logger.log(`PDF Generated: https://drive.google.com/file/d/${pdfFile.getId()}/view?usp=sharing`);
    ui.alert(`PDF generated and saved in 'Report' folder: ${pdfFile.getName()}`);
  }
