// Save Sows
function saveSow() {
  enforceLicenseBeforeScript();
  if (!getLicenseState()) {
    SpreadsheetApp.getUi().alert("License is not active. Please validate your license.");
    return;
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const source = ss.getSheetByName('Sow Management Form');
  const target = ss.getSheetByName('Sow Management Database');
  const litterDB = ss.getSheetByName('Litter Management Database');
  const ui = SpreadsheetApp.getUi();

  if (!source || !target || !litterDB) {
    ui.alert("Error", "One or more required sheets are missing.", ui.ButtonSet.OK);
    return;
  }

  // --- Read form values (trim text IDs)
  const sowId = String(source.getRange('F13').getValue()).trim();
  const boarId = source.getRange('I13').getValue();
  const parity = source.getRange('F15').getValue();
  const litterIdRaw = source.getRange('I15').getValue();
  const litterId = litterIdRaw === '' || litterIdRaw === null ? '' : String(litterIdRaw).trim();
  const matingGroupVal = source.getRange('F17').getValue();   // -> column E
  const dateMatedVal = source.getRange('I17').getValue();     // -> column F
  const actualFarrowVal = source.getRange('F19').getValue();  // -> column G
  const dateWeanedVal = source.getRange('I19').getValue();    // -> column H

  // --- Required validation
  if (!sowId || sowId === "" || parity === "" || parity === null || parity === undefined) {
    ui.alert("Error", "SOW ID and PARITY fields must be filled before saving.", ui.ButtonSet.OK);
    return;
  }

  // --- Gather existing columns to check duplicates
  const sowIDs = target.getRange('A:A').getValues().flat().map(v => String(v || "").trim());
  const parities = target.getRange('C:C').getValues().flat(); // parity may be numeric
  const sowLitterIDs = target.getRange('D:D').getValues().flat().map(v => String(v || "").trim());
  const litterDBIds = litterDB.getRange('E:E').getValues().flat().map(v => String(v || "").trim());

  // --- Duplicate Sow+Parity?
  for (let i = 0; i < sowIDs.length; i++) {
    if (sowIDs[i] === sowId && String(parities[i]) === String(parity)) {
      ui.alert("Error", `Duplicate Sow ID + Parity found in Sow Management Database (Sow: ${sowId}, Parity: ${parity}). Data not saved.`, ui.ButtonSet.OK);
      return;
    }
  }

  // --- Duplicate Litter ID checks (only if user entered a litter ID)
  if (litterId) {
    if (sowLitterIDs.includes(litterId)) {
      ui.alert("Error", `Duplicate Litter ID (${litterId}) found in Sow Management Database. Data not saved.`, ui.ButtonSet.OK);
      return;
    }
    if (litterDBIds.includes(litterId)) {
      ui.alert("Error", `Duplicate Litter ID (${litterId}) found in Litter Management Database. Data not saved.`, ui.ButtonSet.OK);
      return;
    }
  }

  // --- Find next empty row in target (first empty A)
  let nextRowIndex = sowIDs.findIndex(v => v === "" || v === null);
  if (nextRowIndex === -1) {
    // no empty found: append after last row
    nextRowIndex = sowIDs.length;
  }
  const nextRow = nextRowIndex + 1; // convert 0-based index to 1-based row

  // --- Always write core required fields into A..D
  // A = Sow Number, B = Boar Number, C = Parity, D = Litter ID
  target.getRange(nextRow, 1).setValue(sowId);           // A
  target.getRange(nextRow, 2).setValue(boarId);          // B
  target.getRange(nextRow, 3).setValue(parity);          // C
  target.getRange(nextRow, 4).setValue(litterId || "");  // D (write blank if none — optional)

  // --- Conditionally write E, F, G, H only if there is a value on the form.
  // This avoids overwriting any formula that sits in those cells.
  // E = Mating Group  <- write only if F17 not blank
  if (matingGroupVal !== "" && matingGroupVal !== null && matingGroupVal !== undefined) {
    target.getRange(nextRow, 5).setValue(matingGroupVal);
  }
  // F = Date Mated  <- write only if I17 not blank
  if (dateMatedVal !== "" && dateMatedVal !== null && dateMatedVal !== undefined) {
    target.getRange(nextRow, 6).setValue(dateMatedVal);
  }
  // G = Actual Farrowing Date <- write only if F19 not blank
  if (actualFarrowVal !== "" && actualFarrowVal !== null && actualFarrowVal !== undefined) {
    target.getRange(nextRow, 7).setValue(actualFarrowVal);
  }
  // H = Date Weaned <- write only if I19 not blank
  if (dateWeanedVal !== "" && dateWeanedVal !== null && dateWeanedVal !== undefined) {
    target.getRange(nextRow, 8).setValue(dateWeanedVal);
  }

  ui.alert("Success", "Data saved successfully. For results to show, SEARCH AGAIN.", ui.ButtonSet.OK);
}

///Modify Sows
function modifySow() {
  enforceLicenseBeforeScript();
  if (!getLicenseState()) {
    SpreadsheetApp.getUi().alert("License is not active. Please validate your license.");
    return;
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sowFormSheet = ss.getSheetByName('Sow Management Form');
  const sowDB = ss.getSheetByName('Sow Management Database');
  const ui = SpreadsheetApp.getUi();

  if (!sowFormSheet || !sowDB) {
    ui.alert("Error", "One or more required sheets are missing.", ui.ButtonSet.OK);
    return;
  }

  // --- Get form values ---
  const sowId = String(sowFormSheet.getRange('F13').getValue()).trim();
  const boarId = sowFormSheet.getRange('I13').getValue();
  const parity = sowFormSheet.getRange('F15').getValue();
  const litterIdRaw = sowFormSheet.getRange('I15').getValue();
  const litterId = litterIdRaw ? String(litterIdRaw).trim() : "";
  const matingGroupVal = sowFormSheet.getRange('F17').getValue();
  const dateMatedVal = sowFormSheet.getRange('I17').getValue();
  const actualFarrowVal = sowFormSheet.getRange('F19').getValue();
  const dateWeanedVal = sowFormSheet.getRange('I19').getValue();

  if (!sowId || sowId === "" || parity === "" || parity === null || parity === undefined) {
    ui.alert("Error", "SOW ID and PARITY fields must be filled before modifying.", ui.ButtonSet.OK);
    return;
  }

  // --- Confirm modification ---
  const response = ui.alert(
    'Confirm Modification',
    `Are you sure you want to modify the data for Sow ID (${sowId}) with Parity (${parity})?`,
    ui.ButtonSet.YES_NO
  );
  if (response !== ui.Button.YES) {
    ui.alert('Modification Cancelled', 'No changes have been made.', ui.ButtonSet.OK);
    return;
  }

  // --- Find matching row ---
  const lastRow = sowDB.getLastRow();
  const sowIDs = sowDB.getRange('A1:A' + lastRow).getValues().flat().map(v => String(v || "").trim());
  const parities = sowDB.getRange('C1:C' + lastRow).getValues().flat();

  const foundRowIndex = sowIDs.findIndex((id, i) => id === sowId && String(parities[i]) === String(parity));
  if (foundRowIndex === -1) {
    ui.alert('Error', 'No matching data found in the Sow Management Database. Modification failed.', ui.ButtonSet.OK);
    return;
  }

  const rowNum = foundRowIndex + 1;

