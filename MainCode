// === Helper Functions ===

 function parseDateRangeString(str) {
  // Expected format: "dd/mm/yyyy Through dd/mm/yyyy"
  const parts = str.split(" Through ");
  if (parts.length === 0) return [null, null];

  const start = toDate(parts[0]);
  const end = parts[1] ? toDate(parts[1]) : start;
  return [start, end];
 }

 function toDate(str) {
  const match = str.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
  if (!match) return null;

  let [, d, m, y] = match.map(Number);
  if (y < 100) y += 2000;
  return new Date(y, m - 1, d);
 }

function normalizeDate(date) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate());
}

function getStartOfWeek(date) {
  const d = new Date(date);
  const day = d.getDay(); // Sunday = 0
  return new Date(d.setDate(d.getDate() - day));
}

function getEndOfWeek(date) {
  const start = getStartOfWeek(date);
  return new Date(start.getTime() + 6 * 86400000);
}

function isDateInRange(start, end, weekStart, weekEnd) {
  const s = normalizeDate(start);
  const e = normalizeDate(end);
  return (s <= weekEnd && e >= weekStart);
}


