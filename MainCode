    const sowId = row[0]; // Column A
    const parity = row[2]; // Column C

    activityColumns.forEach(activity => {
      const [colA, colB] = activity.cols;

      // Process single-column activities
      if (colA === colB) {
        const value = row[colA];
        if (value) processActivity(value, activity, sowId, parity);
        return;
      }

      // Process multi-column activities
      const valueA = row[colA];
      const valueB = colB !== null ? row[colB] : null;
      if (valueA) processActivity(valueA, activity, sowId, parity);
      if (valueB) processActivity(valueB, activity, sowId, parity);
    });
  }

  if (activities.length > 0) {
    var response = ui.alert('There are activities to do this week. Would you like me to print it for you?', ui.ButtonSet.YES_NO);
