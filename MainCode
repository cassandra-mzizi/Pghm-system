// === ACTIVITY PROCESSING ===
  function processActivity(value, activity, sowId, parity) {
    const [startDate, endDate] = parseDateRanges(value);
    if (!startDate || !endDate) {
      Logger.log(`Unable to parse date for activity: ${activity.name}, Value: ${value}`);
      return;
    }

    const normalizedStart = normalizeDate(startDate);
    const normalizedEnd = normalizeDate(endDate);

    // Determine activity duration
    const difference_in_date = Math.round((normalizedEnd - normalizedStart) / (1000 * 3600 * 24));
    const multiday = difference_in_date > 1;
    const two_day = difference_in_date === 1;

    if (isDateInRange(normalizedStart, normalizedEnd, startOfWeek, endOfWeek)) {
      activities.push({
        date: normalizedStart,
        name: activity.name,
        sowId: sowId,
        parity: parity,
        multiday: multiday,
        two_day: two_day
      });
      Logger.log(`Captured activity: ${activity.name}, Sow ID: ${sowId}, Parity: ${parity}`);
    }
  }

  function getStartOfWeek(date) {
    const d = new Date(date);
    const day = d.getDay();
    const diff = d.getDate() - day; // Sunday as start of the week
    return new Date(d.setDate(diff));
  }

  function getEndOfWeek(date) {
    const start = getStartOfWeek(date);
    return new Date(start.getTime() + 6 * 24 * 60 * 60 * 1000);
  }

  function normalizeDate(date) {
    return new Date(date.getFullYear(), date.getMonth(), date.getDate());
  }

  function isDateInRange(startDate, endDate, weekStart, weekEnd) {
    return (startDate <= weekEnd && endDate >= weekStart);
  }

// === DATE PARSER ===
  function parseDateRanges(value) {
  if (value instanceof Date) return [value, value];

  // Normalise whitespace
  const txt = value.toString().trim().replace(/\s+/g, " ");
  // Detect separator
  const parts = txt.includes(" Through ")
      ? txt.split(" Through ")
      : txt.includes(" OR ")
      ? txt.split(" OR ")
      : [txt];

  const start = toDate(parts[0]);
  const end   = toDate(parts[1] || parts[0]);      // fall back to same day
  return [start, end];
  }

  function toDate(str) {
  if (!str) return null;
  if (str instanceof Date) return str;

  // Accept 1‑ or 2‑digit day / month and 2‑ or 4‑digit year
  const match = str.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/);
  if (!match) return null;

  let [, d, m, y] = match.map(Number);
  if (y < 100) y += 2000;              // treat “25” as 2025, not year 25
  return new Date(y, m - 1, d);
  }

// === PDF GENERATION ===
  function generatePDF(activities, startOfWeek, endOfWeek) {
  const doc = DocumentApp.create(`Weekly Report: ${formatDate(startOfWeek)} - ${formatDate(endOfWeek)}`);
  const body = doc.getBody();

// === TITLE FORMATTING ===
  const titlePara = body.appendParagraph('Weekly Report for');
  titlePara.setAlignment(DocumentApp.HorizontalAlignment.CENTER)
