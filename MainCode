    appendField(body, 'Number Weaned', litter[12]);             // M
    appendField(body, 'Date Killed', litter[13]);               // N
    appendField(body, 'Number Sent To Abattoir', litter[14]);   // O
    appendField(body, 'Total Carcass Weight', litter[15]);      // P
    appendField(body, 'Age at Slaughter', litter[16]);          // Q
    appendField(body, 'Number Sold as Breeding Stock', litter[17]); // R
    appendField(body, 'Total Weight Sold Live', litter[18]);    // S
  }
  else {
      body.appendParagraph('No litter data found.')
        .setItalic(true);
    }

    body.appendHorizontalRule();
  });

