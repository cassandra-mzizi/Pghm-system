  if (!litterId || litterId.trim() === "") {
    SpreadsheetApp.getUi().alert("Mandatory field missing: Litter ID is required. Please fill it in and try again.");
    return;
  }

  const dobFormatted = dob instanceof Date ? Utilities.formatDate(dob, Session.getScriptTimeZone(), "dd/MM/yyyy") : dob;
  const dateWeanedFormatted = dateWeaned instanceof Date ? Utilities.formatDate(dateWeaned, Session.getScriptTimeZone(), "dd/MM/yyyy") : dateWeaned;

